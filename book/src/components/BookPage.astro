    document.documentElement.classList.add('js');
    document.body.classList.add('js');
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Po dacie wydarzenia znikają pasek i sekcja (bez przebudowy strony).
    document.querySelectorAll('[data-until]').forEach(function (el) {
      var end = new Date(el.getAttribute('data-until') + 'T23:59:59+02:00');
      if (Date.now() > end.getTime()) el.remove();
    });

    // Nawigacja: stan zależny od tła pod spodem.
    var nav = document.querySelector('[data-nav]');
    var dark = Array.prototype.slice.call(document.querySelectorAll('.hero, .promise, .voices, .night, .foot'));
    function navState() {
      if (!nav) return;
      var y = nav.getBoundingClientRect().bottom;
      var overDark = dark.some(function (s) { var r = s.getBoundingClientRect(); return r.top <= y && r.bottom >= y; });
      var scrolled = window.scrollY > 40;
      nav.classList.toggle('is-solid', scrolled && overDark);
      nav.classList.toggle('is-light', scrolled && !overDark);
    }
    var promise = document.querySelector('[data-promise]');
    var words = promise ? Array.prototype.slice.call(promise.querySelectorAll('.w')) : [];
    function promiseState() {
      if (!promise || reduce) return;
      var r = promise.getBoundingClientRect();
      var p = Math.max(0, Math.min(1, (innerHeight * 0.85 - r.top) / (r.height * 0.75)));
      var n = Math.round(p * words.length);
      words.forEach(function (w, i) { w.classList.toggle('lit', i < n); });
    }
    var path = document.querySelector('[data-path]');
    var fill = document.querySelector('[data-path-fill]');
    function pathState() {
      if (!path || !fill) return;
      if (reduce) { fill.style.setProperty('--p', 1); return; }
      var r = path.getBoundingClientRect();
      fill.style.setProperty('--p', Math.max(0, Math.min(1, (innerHeight * 0.75 - r.top) / (r.height * 0.7))).toFixed(3));
    }
    var ticking = false;
    function onScroll() { if (ticking) return; ticking = true; requestAnimationFrame(function () { navState(); promiseState(); pathState(); ticking = false; }); }
    addEventListener('scroll', onScroll, { passive: true }); addEventListener('resize', onScroll); onScroll();

    // Menu i języki: zamknij po kliknięciu poza nimi / w link.
    document.addEventListener('click', function (e) {
      document.querySelectorAll('details.menu[open], details.langs[open]').forEach(function (d) { if (!d.contains(e.target) || e.target.closest('a')) d.removeAttribute('open'); });
    });

    // Hero: książka i światło reagują na kursor.
    var hero = document.querySelector('[data-hero]'), tilt = document.querySelector('[data-tilt]'), beam = hero && hero.querySelector('.beam');
    if (hero && tilt && !reduce && matchMedia('(pointer: fine)').matches) {
      hero.addEventListener('pointermove', function (e) {
        var r = hero.getBoundingClientRect(), x = (e.clientX - r.left) / r.width - 0.5, y = (e.clientY - r.top) / r.height - 0.5;
        tilt.style.setProperty('--ry', (26 + x * 16).toFixed(2) + 'deg'); tilt.style.setProperty('--rx', (4 - y * 8).toFixed(2) + 'deg');
        if (beam) beam.style.setProperty('--bx', (x * 40).toFixed(1) + 'px');
      });
      hero.addEventListener('pointerleave', function () { tilt.style.setProperty('--ry', '26deg'); tilt.style.setProperty('--rx', '4deg'); if (beam) beam.style.setProperty('--bx', '0px'); });
    }

    // Hero: drobinki w świetle.
    var canvas = document.querySelector('[data-motes]');
    if (canvas && !reduce) {
      var ctx = canvas.getContext('2d'), motes = [], W = 0, H = 0, dpr = Math.min(devicePixelRatio || 1, 2), running = true;
      function size() {
        var r = canvas.getBoundingClientRect(); W = r.width; H = r.height; canvas.width = W * dpr; canvas.height = H * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        motes = []; for (var i = 0, c = W < 640 ? 26 : 54; i < c; i++) motes.push({ x: Math.random() * W, y: Math.random() * H, r: .6 + Math.random() * 1.8, vx: (Math.random() - .5) * .12, vy: -.05 - Math.random() * .18, t: Math.random() * 6.28 });
      }
      function frame() {
        if (!running) return; ctx.clearRect(0, 0, W, H);
        for (var i = 0; i < motes.length; i++) {
          var m = motes[i]; m.x += m.vx + Math.sin(m.t) * .08; m.y += m.vy; m.t += .01;
          if (m.y < -10) { m.y = H + 10; m.x = Math.random() * W; } if (m.x < -10) m.x = W + 10; if (m.x > W + 10) m.x = -10;
          var inB = Math.max(0, 1 - Math.abs(m.x / W - (.72 - (m.y / H) * .35)) * 3.2), a = .12 + inB * .6 + Math.sin(m.t * 3) * .06;
          ctx.beginPath(); ctx.arc(m.x, m.y, m.r, 0, 6.283); ctx.fillStyle = 'rgba(255,240,196,' + a.toFixed(3) + ')'; ctx.fill();
        }
        requestAnimationFrame(frame);
      }
      size(); frame(); addEventListener('resize', size);
      if ('IntersectionObserver' in window) new IntersectionObserver(function (es) { var v = es[0].isIntersecting; if (v && !running) { running = true; frame(); } else if (!v) running = false; }).observe(canvas);
    }

    // Rekomendacje: wybór z listy + automatyczna zmiana co 14 s (pauza po kliknięciu / najechaniu).
    var voices = document.querySelector('[data-voices]');
    if (voices) {
      var qs = voices.querySelectorAll('.quote'), bs = voices.querySelectorAll('[data-q]'), cur = 0, timer, paused = false;
      function show(i) {
        qs[cur].classList.remove('is-on'); if (bs[cur]) bs[cur].setAttribute('aria-pressed', 'false');
        cur = i; qs[cur].classList.add('is-on'); if (bs[cur]) bs[cur].setAttribute('aria-pressed', 'true');
      }
      bs.forEach(function (b) { b.addEventListener('click', function () { paused = true; clearInterval(timer); show(+b.getAttribute('data-q')); }); });
      if (qs.length > 1 && !reduce) {
        timer = setInterval(function () { if (!paused) show((cur + 1) % qs.length); }, 14000);
        voices.addEventListener('mouseenter', function () { paused = true; }); voices.addEventListener('mouseleave', function () { if (!timer) return; paused = false; });
      }
    }

    // Galeria: zakładki (strzałki) + podgląd zdjęć.
    var gal = document.querySelector('[data-gallery]');
    if (gal) {
      var tabs = Array.prototype.slice.call(gal.querySelectorAll('[role=tab]'));
      function sel(i, focus) {
        tabs.forEach(function (t, j) { var on = i === j; t.setAttribute('aria-selected', on); t.tabIndex = on ? 0 : -1; document.getElementById(t.getAttribute('aria-controls')).hidden = !on; });
        if (focus) tabs[i].focus();
      }
      tabs.forEach(function (t, i) {
        t.addEventListener('click', function () { sel(i); });
        t.addEventListener('keydown', function (e) { if (e.key === 'ArrowRight') sel((i + 1) % tabs.length, true); if (e.key === 'ArrowLeft') sel((i - 1 + tabs.length) % tabs.length, true); });
      });
      var lb = gal.querySelector('[data-lightbox]'), lbImg = gal.querySelector('[data-lb-img]'), list = [], idx = 0;
      function openAt(i) { idx = (i + list.length) % list.length; var a = list[idx]; lbImg.src = a.getAttribute('data-full'); lbImg.alt = a.querySelector('img').alt; if (!lb.open) lb.showModal(); }
      gal.querySelectorAll('.gal-item').forEach(function (a) {
        a.addEventListener('click', function (e) {
          if (!lb || !lb.showModal) return; e.preventDefault();
          list = Array.prototype.slice.call(a.parentElement.querySelectorAll('.gal-item')); openAt(list.indexOf(a));
        });
      });
      if (lb) {
        gal.querySelector('[data-lb-close]').addEventListener('click', function () { lb.close(); });
        gal.querySelector('[data-lb-prev]').addEventListener('click', function () { openAt(idx - 1); });
        gal.querySelector('[data-lb-next]').addEventListener('click', function () { openAt(idx + 1); });
        lb.addEventListener('click', function (e) { if (e.target === lb) lb.close(); });
        lb.addEventListener('keydown', function (e) { if (e.key === 'ArrowRight') openAt(idx + 1); if (e.key === 'ArrowLeft') openAt(idx - 1); });
      }
    }
  })();
</script>
</body>
</html>

---
import { DICTS } from '../i18n';
import { LANGS, LINKS, EDITIONS, EVENTS, GALLERY, RESOURCES, NEWSLETTER_ACTION, langPath, type Lang } from '../config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = DICTS[lang];
const site = Astro.site ?? new URL('https://www.icpebook.org');
const canonical = new URL(langPath(lang), site).toString();
const ogImage = new URL('/img/cover.jpg', site).toString();

const primaryHref = t.hero.primaryHref === 'polish' ? LINKS.polishEdition : LINKS.amazon;
const words = t.promise.text.split(' ');
const tw = t.title.split(' ');
const cut = Math.ceil(tw.length / 2);
const titleA = tw.slice(0, cut).join(' ');
const titleB = tw.slice(cut).join(' ');

// Wydarzenia: tylko przyszłe (build) — przeglądarka i tak ukrywa po dacie.
const today = new Date().toISOString().slice(0, 10);
const events = EVENTS.filter((e) => e.date >= today);
const launch = events[0];
const fmtDate = (iso: string) => new Intl.DateTimeFormat(t.htmlLang, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(iso + 'T12:00:00Z'));
const fmtShort = (iso: string) => new Intl.DateTimeFormat(t.htmlLang, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(iso + 'T12:00:00Z'));
const dm = (iso: string) => { const [, m, d] = iso.split('-'); return `${d}.${m}`; };

const galleryTabs = (['community', 'outreach', 'events'] as const).map((k) => ({ key: k, label: t.gallery.tabs[k], photos: GALLERY[k] }));
const ko = lang === 'ko';
const longQuote = (s: string) => s.length > 520;
---

<!doctype html>
<html lang={t.htmlLang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{t.meta.title}</title>
  <meta name="description" content={t.meta.description} />
  <link rel="canonical" href={canonical} />
  {LANGS.map((l) => <link rel="alternate" hreflang={DICTS[l].htmlLang} href={new URL(langPath(l), site).toString()} />)}
  <link rel="alternate" hreflang="x-default" href={new URL('/', site).toString()} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:type" content="book" />
  <meta property="og:title" content={t.meta.title} />
  <meta property="og:description" content={t.meta.description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content={t.htmlLang} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#0c1a14" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href={`https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700${ko ? '&family=Noto+Serif+KR:wght@300;400;500&family=Noto+Sans+KR:wght@400;500;700' : ''}&display=swap`} rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'Book', name: `${t.title}. ${t.subtitle}`, inLanguage: t.htmlLang,
    author: [{ '@type': 'Person', name: 'Anna Cappello Fava' }, { '@type': 'Person', name: 'A.G. Harmon' }],
    image: ogImage, url: canonical, publisher: { '@type': 'Organization', name: 'ICPE Mission', url: LINKS.icpe },
  })} />
</head>
<body class={ko ? 'is-ko' : ''}>
<div class="acl" id="top">

  {launch && (
    <a class="bar" href={launch.href} target="_blank" rel="noopener" data-until={launch.date}>
      <span class="bar-spark" aria-hidden="true"></span>
      <span class="bar-text"><strong>{t.launchBar.label}</strong> <span class="bar-when">{fmtShort(launch.date)}, {launch.city}</span></span>
      <span class="bar-cta">{t.launchBar.cta}</span>
    </a>
  )}

  <header class="nav" data-nav>
    <div class="nav-in">
      <a class="brand" href={langPath(lang)}>
        <img src="/img/logo-cream.png" alt="" width="34" height="34" class="logo-dark" />
        <img src="/img/logo.png" alt="" width="34" height="34" class="logo-light" />
        <span>{t.title}</span>
      </a>
      <nav class="nav-links" aria-label={t.nav.menu}>
        <a href="#book">{t.nav.book}</a>
        <a href="#editions">{t.nav.editions}</a>
        <a href="#author">{t.nav.author}</a>
        <a href="#endorsements">{t.nav.endorsements}</a>
        <a href="#gallery">{t.nav.gallery}</a>
        <a href="#resources">{t.nav.resources}</a>
      </nav>
      <details class="langs">
        <summary aria-label={t.nav.language}>{lang.toUpperCase()}<svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></summary>
        <ul>
          {LANGS.map((l) => (
            <li><a href={langPath(l)} hreflang={DICTS[l].htmlLang} lang={DICTS[l].htmlLang} aria-current={l === lang ? 'page' : undefined}>{DICTS[l].nativeName}</a></li>
          ))}
        </ul>
      </details>
      <a class="btn btn-beam btn-sm nav-cta" href={primaryHref} target="_blank" rel="noopener">{t.nav.order}</a>
      <details class="menu">
        <summary aria-label={t.nav.menu}><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg></summary>
        <nav aria-label={t.nav.menu}>
          <a href="#book">{t.nav.book}</a>
          <a href="#editions">{t.nav.editions}</a>
          <a href="#author">{t.nav.author}</a>
          <a href="#endorsements">{t.nav.endorsements}</a>
          <a href="#gallery">{t.nav.gallery}</a>
          <a href="#resources">{t.nav.resources}</a>
          <a class="btn btn-beam" href={primaryHref} target="_blank" rel="noopener">{t.nav.order}</a>
        </nav>
      </details>
    </div>
  </header>

  <section class="hero" data-hero>
    <div class="beam" aria-hidden="true"><span class="ray r1"></span><span class="ray r2"></span><span class="ray r3"></span></div>
    <canvas class="motes" data-motes aria-hidden="true"></canvas>
    <div class="hero-in">
      <div class="hero-copy">
        <p class="kicker">{t.hero.kicker}</p>
        <h1 class="title"><span class="t1">{titleA}</span> <span class="t2">{titleB}</span></h1>
        <p class="byline">Anna Cappello Fava <span>{t.coauthor}</span></p>
        <p class="lede">{t.hero.lede}</p>
        <div class="hero-cta">
          <a class="btn btn-beam" href={primaryHref} target="_blank" rel="noopener">{t.hero.primary}</a>
          <a class="btn btn-ghost" href="#book">{t.hero.secondary}</a>
        </div>
        <p class="hero-note">{t.hero.note}</p>
      </div>
      <div class="hero-book" data-tilt>
        <div class="book">
          <img class="book-front" src="/img/cover.jpg" alt={t.book.coverAlt} width="986" height="1500" fetchpriority="high" />
          <div class="book-spine" aria-hidden="true"><span>a cast of light</span></div>
          <div class="book-pages" aria-hidden="true"></div>
        </div>
        <div class="book-shadow" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <section class="promise" data-promise>
    <div class="wrap">
      <p class="promise-lead">{t.promise.lead}</p>
      <p class="promise-text" aria-label={t.promise.text}>{words.map((w) => <span class="w" aria-hidden="true">{w} </span>)}</p>
    </div>
  </section>
  <div class="dawn" aria-hidden="true"></div>

  <section class="sec" id="book">
    <div class="wrap two">
      <div class="side">
        <h2 class="h2">{t.book.h2}</h2>
        <figure class="photo">
          <img src="/img/john-paul-ii.jpg" alt={t.book.photoAlt} width="1416" height="1111" loading="lazy" />
          <figcaption>{t.book.photoCaption}</figcaption>
        </figure>
      </div>
      <div class="prose">
        <p class="drop">{t.book.p1}</p>
        <p>{t.book.p2}</p>
        <div class="inside">
          <h3>{t.book.insideH}</h3>
          <ul>{t.book.inside.map((x) => <li>{x}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <section class="sec tint" id="editions">
    <div class="wrap">
      <h2 class="h2">{t.editions.h2}</h2>
      <p class="lead">{t.editions.lead}</p>
      <ul class="eds">
        {EDITIONS.map((e) => (
          <li class={`ed${e.lang === lang ? ' is-here' : ''}`} lang={DICTS[e.lang].htmlLang}>
            <p class="ed-lang">{e.native}</p>
            <div>
              <p class="ed-title">{e.title}</p>
              <p class={`ed-status st-${e.status}`} lang={t.htmlLang}>
                {e.status === 'available' && t.editions.available}
                {e.status === 'launch' && launch && `${t.editions.launch}: ${fmtShort(launch.date)}, ${launch.city}`}
                {e.status === 'launch' && !launch && t.editions.available}
                {e.status === 'soon' && t.editions.soon}
              </p>
            </div>
            <span lang={t.htmlLang}>
              {e.status === 'available' && <a class="btn btn-ink" href={e.href} target="_blank" rel="noopener">{t.editions.order}</a>}
              {e.status === 'launch' && <a class="btn btn-ink" href={e.href} target="_blank" rel="noopener">{t.editions.polish}</a>}
              {e.status === 'soon' && <a class="link" href="#newsletter">{t.editions.notify}</a>}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec" data-path>
    <div class="wrap">
      <h2 class="h2 narrow">{t.journey.h2}</h2>
      <div class="track">
        <span class="track-line" aria-hidden="true"><span class="track-fill" data-path-fill></span></span>
        <ol class="steps">
          {t.journey.steps.map((s, i) => (
            <li class={i === t.journey.steps.length - 1 ? 'is-now' : ''}>
              <span class="dot" aria-hidden="true"></span>
              <p class="step-year">{s.year}</p>
              <p class="step-place">{s.place}</p>
              <p class="step-text">{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="sec tint" id="author">
    <div class="wrap author">
      <figure class="photo portrait">
        <img src="/img/anna.jpg" alt={t.author.alt} width="649" height="1200" loading="lazy" />
      </figure>
      <div class="author-body">
        <h2 class="h2">Anna Cappello Fava</h2>
        <p class="author-lead">{t.author.lead}</p>
        <p>{t.author.p1}</p>
        <p>{t.author.p2}</p>
      </div>
    </div>
  </section>

  <section class="sec voices" id="endorsements" data-voices>
    <div class="wrap">
      <h2 class="h2">{t.endorsements.h2}</h2>
      <div class="voices-grid">
        <div class="quotes" aria-live="polite">
          {t.endorsements.items.map((q, i) => (
            <figure class={`quote${i === 0 ? ' is-on' : ''}${longQuote(q.text) ? ' is-long' : ''}`} id={`q${i}`}>
              <svg class="mark" viewBox="0 0 40 40" aria-hidden="true"><g stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M20 3v8M20 29v8M3 20h8M29 20h8M8 8l5.5 5.5M26.5 26.5L32 32M32 8l-5.5 5.5M13.5 26.5L8 32" /></g><circle cx="20" cy="20" r="4" fill="currentColor" /></svg>
              <blockquote><p>{q.text}</p></blockquote>
              <figcaption><span class="q-name">{q.name}</span><span class="q-role">{q.role}</span></figcaption>
            </figure>
          ))}
        </div>
        {t.endorsements.items.length > 1 && (
          <div class="who">
            <p class="who-h">{t.endorsements.count} ({t.endorsements.items.length})</p>
            <ul>
              {t.endorsements.items.map((q, i) => (
                <li><button type="button" data-q={i} aria-controls={`q${i}`} aria-pressed={i === 0 ? 'true' : 'false'}>{q.name}</button></li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="sec" id="gallery" data-gallery>
    <div class="wrap">
      <div class="gal-head">
        <h2 class="h2">{t.gallery.h2}</h2>
        <div class="tabs" role="tablist" aria-label={t.nav.gallery}>
          {galleryTabs.map((g, i) => (
            <button type="button" role="tab" id={`tab-${g.key}`} aria-controls={`panel-${g.key}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{g.label}</button>
          ))}
        </div>
      </div>
      {galleryTabs.map((g, i) => (
        <div class="gal" role="tabpanel" id={`panel-${g.key}`} aria-labelledby={`tab-${g.key}`} hidden={i !== 0}>
          {g.photos.map((p, j) => (
            <a class={`gal-item${j === 0 ? ' is-wide' : ''}`} href={`/img/gallery/${p.file}`} data-full={`/img/gallery/${p.file}`}>
              <img src={`/img/gallery/thumb-${p.file}`} alt={`${t.gallery.photo} (${g.label} ${j + 1})`} width={p.w} height={p.h} loading="lazy" />
            </a>
          ))}
        </div>
      ))}
    </div>
    <dialog class="lightbox" data-lightbox aria-label={t.nav.gallery}>
      <img alt="" data-lb-img />
      <button type="button" class="lb-btn lb-close" data-lb-close aria-label={t.gallery.close}><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></button>
      <button type="button" class="lb-btn lb-prev" data-lb-prev aria-label={t.gallery.prev}><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></button>
      <button type="button" class="lb-btn lb-next" data-lb-next aria-label={t.gallery.next}><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></button>
    </dialog>
  </section>

  <section class="sec night" id="resources">
    <div class="beam beam-soft" aria-hidden="true"><span class="ray r1"></span></div>
    <div class="wrap">
      <h2 class="h2">{t.resources.h2}</h2>
      <p class="lead">{t.resources.lead}</p>
      <div class="res">
        {RESOURCES.map((r) => {
          const it = t.resources.items[r.key];
          return r.file ? (
            <a class="res-card" href={r.file} download>
              <span class="res-title">{it.title}</span>
              <span class="res-text">{it.text}</span>
              <span class="res-cta">{t.resources.download}</span>
            </a>
          ) : (
            <div class="res-card is-soon">
              <span class="res-title">{it.title}</span>
              <span class="res-text">{it.text}</span>
              <span class="res-cta">{t.resources.soon}</span>
            </div>
          );
        })}
      </div>
      <div class="news" id="newsletter">
        <h3>{t.resources.newsletter.h}</h3>
        {NEWSLETTER_ACTION ? (
          <form class="news-form" method="post" action={NEWSLETTER_ACTION} target="_blank">
            <div class="field"><label for="nl-name">{t.resources.newsletter.firstName}</label><input id="nl-name" name="FIRSTNAME" type="text" autocomplete="given-name" /></div>
            <div class="field grow"><label for="nl-email">{t.resources.newsletter.email}</label><input id="nl-email" name="EMAIL" type="email" autocomplete="email" required /></div>
            <button class="btn btn-beam" type="submit">{t.resources.newsletter.submit}</button>
            <p class="fine">{t.resources.newsletter.gdpr}</p>
          </form>
        ) : (
          <p><a class="btn btn-beam" href={`mailto:${LINKS.email}?subject=${encodeURIComponent(t.resources.newsletter.h)}`}>{t.resources.newsletter.fallback}</a></p>
        )}
      </div>
    </div>
  </section>

  {launch && (
    <section class="sec" data-until={launch.date}>
      <div class="wrap two center">
        <div>
          <h2 class="h2">{t.events.h2}</h2>
          <p class="lead">{t.events.lead}</p>
        </div>
        <a class="event" href={launch.href} target="_blank" rel="noopener">
          <span class="ev-date">{dm(launch.date)}</span>
          <span class="ev-body">
            <span class="ev-title">{t.events.title}</span>
            <span class="ev-meta">{fmtDate(launch.date)}{t.events.timeWord ? `, ${t.events.timeWord} ${launch.time}` : ` ${launch.time}`}</span>
            <span class="ev-meta">{launch.venue}, {launch.city}</span>
            <span class="ev-cta">{t.events.cta}</span>
          </span>
        </a>
      </div>
    </section>
  )}

  <footer class="foot">
    <div class="wrap foot-grid">
      <div>
        <a class="brand" href={LINKS.icpe} target="_blank" rel="noopener"><img src="/img/logo-cream.png" alt="" width="30" height="30" /><span>ICPE Mission</span></a>
        <p>{t.footer.about}</p>
      </div>
      <div>
        <p class="foot-h">{t.footer.contact}</p>
        <a href={`mailto:${LINKS.email}`}>{LINKS.email}</a>
        <a href={`tel:${LINKS.phone.replace(/\s/g, '')}`}>{LINKS.phone}</a>
        <a href={`tel:${LINKS.mobile.replace(/\s/g, '')}`}>{LINKS.mobile}</a>
        <p>{LINKS.address}</p>
      </div>
      <div>
        <p class="foot-h">{t.footer.follow}</p>
        <a href={LINKS.instagram} target="_blank" rel="noopener">Instagram</a>
        <a href={LINKS.facebook} target="_blank" rel="noopener">Facebook</a>
        <a href={LINKS.icpe} target="_blank" rel="noopener">icpe.org</a>
      </div>
    </div>
    <p class="wrap copy">© {new Date().getFullYear()} ICPE Mission</p>
  </footer>
</div>

<style is:global>
  :root {
    --night: #0c1a14; --moss: #17301f; --fern: #3e6b4a; --beam: #f2d48a; --beam-hi: #fff3cf; --ember: #85601c;
    --day: #f5f1e2; --day-2: #ebe5cf; --ink: #16241c; --ink-soft: #46554b; --line: rgba(22, 36, 28, .14);
    --serif: 'Cormorant Garamond', 'Times New Roman', serif; --sans: 'Bricolage Grotesque', system-ui, sans-serif;
  }
  .is-ko { --serif: 'Noto Serif KR', 'Cormorant Garamond', serif; --sans: 'Noto Sans KR', 'Bricolage Grotesque', sans-serif; word-break: keep-all; }
  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; -webkit-font-smoothing: antialiased; }
  body { margin: 0; background: var(--day); color: var(--ink); font-family: var(--sans); line-height: 1.6; }
  .acl { overflow-x: clip; }
  .acl :where(h1, h2, h3, p, ul, ol, figure, blockquote, dl, dd) { margin: 0; }
  img { max-width: 100%; height: auto; display: block; }
  a { color: inherit; }
  :focus-visible { outline: 2px solid var(--beam); outline-offset: 3px; border-radius: 4px; }
  [id] { scroll-margin-top: 80px; }
  .wrap { max-width: 1200px; margin: 0 auto; padding: 0 40px; }
  .h2 { font-family: var(--serif); font-weight: 400; font-size: clamp(38px, 5vw, 62px); line-height: 1.04; letter-spacing: -.01em; }
  .is-ko .h2 { font-weight: 300; letter-spacing: -.02em; line-height: 1.2; }
  .narrow { max-width: 14em; }
  .lead { margin-top: 18px; font-size: 18px; line-height: 1.55; color: var(--ink-soft); max-width: 52ch; }

  .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 50px; padding: 0 26px; border-radius: 100px; font: 600 15.5px/1.1 var(--sans); text-decoration: none; cursor: pointer; border: 1px solid transparent; text-align: center; transition: background .2s, color .2s, border-color .2s, box-shadow .3s; }
  .btn-sm { min-height: 40px; padding: 0 18px; font-size: 14px; }
  .btn-beam { background: var(--beam); color: var(--night); }
  .btn-beam:hover { background: var(--beam-hi); box-shadow: 0 0 36px 2px rgba(242, 212, 138, .35); }
  .btn-ghost { background: transparent; color: var(--day); border-color: rgba(245, 241, 226, .35); }
  .btn-ghost:hover { border-color: var(--beam); color: var(--beam); }
  .btn-ink { background: var(--ink); color: var(--day); }
  .btn-ink:hover { background: var(--moss); }
  .link { font-weight: 600; text-underline-offset: 5px; text-decoration-color: var(--ember); }

  /* Pasek premiery */
  .bar { position: relative; z-index: 60; display: flex; justify-content: center; align-items: center; gap: 14px; padding: 11px 24px; background: #10231a; color: var(--day); text-decoration: none; font-size: 14.5px; line-height: 1.35; border-bottom: 1px solid rgba(242, 212, 138, .22); }
  .bar strong { font-weight: 600; }
  .bar-when { color: var(--beam); }
  .bar-spark { flex: 0 0 auto; width: 8px; height: 8px; border-radius: 50%; background: var(--beam); animation: glow 2.8s ease-out infinite; }
  .bar-cta { flex: 0 0 auto; padding: 6px 14px; border-radius: 100px; border: 1px solid rgba(242, 212, 138, .55); color: var(--beam); font-weight: 600; font-size: 13.5px; }
  .bar:hover .bar-cta { background: var(--beam); color: var(--night); }
  @keyframes glow { 0% { box-shadow: 0 0 0 0 rgba(242, 212, 138, .55); } 70% { box-shadow: 0 0 0 10px rgba(242, 212, 138, 0); } 100% { box-shadow: 0 0 0 0 rgba(242, 212, 138, 0); } }

  /* Nawigacja */
  .nav { position: sticky; top: 0; z-index: 50; color: var(--day); transition: background .35s, color .35s, box-shadow .35s; }
  .nav-in { max-width: 1320px; margin: 0 auto; padding: 14px 40px; display: flex; align-items: center; gap: 22px; }
  .brand { display: inline-flex; align-items: center; gap: 11px; color: inherit; text-decoration: none; }
  .brand span { font-family: var(--serif); font-style: italic; font-size: 23px; line-height: 1; }
  .brand img { width: 34px; height: 34px; }

# ── Backend (api) ─────────────────────────────────────────
DATABASE_URL=postgresql://icpe:icpe@localhost:5432/icpe?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-dev-secret
JWT_REFRESH_SECRET=change-me-dev-refresh
# token serwisowy dla Personal OS (admin:read[,admin:write])
SERVICE_TOKEN=dev-personal-os-token
PORT=3000

# Płatności (adaptery) — w dev używamy trybu mock
PAYMENTS_MODE=mock           # mock | live
P24_MERCHANT_ID=
P24_CRC=
STRIPE_SECRET_KEY=

# Mail (dev: log do konsoli)
MAIL_MODE=log                # log | smtp | resend (puste + RESEND_API_KEY → resend)
MAIL_FROM="ICPE Mission <rejestracja@icpemission.pl>"
RESEND_API_KEY=
MAIL_REPLY_TO=
# Opcjonalny link do polityki prywatności (mail „udział potwierdzony” dla gości dodanych przez organizatora)
PRIVACY_POLICY_URL=

# Formacja online (panel kursanta) — docs/13-handoff-formacja-online.md
MEMBER_JWT_SECRET=change-me-member
FILE_SIGNING_SECRET=change-me-files
PUBLIC_SITE_URL=http://localhost:4321
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_KEY=
BUNNY_STREAM_CDN_HOSTNAME=
BUNNY_STREAM_WEBHOOK_KEY=

# ── Frontend (app) ────────────────────────────────────────
VITE_API_URL=http://localhost:3000

---
// /nowosci/<adres>/ — pełny wpis. Treść z src/content/nowosci/<adres>/pl.md (+ en.md).
import LandingLayout from '../../layouts/LandingLayout.astro';
import SiteShell from '../../components/SiteShell.astro';
import Bi from '../../components/news/Bi.astro';
import NewsMeta from '../../components/news/NewsMeta.astro';
import NewsCard from '../../components/news/NewsCard.astro';
import { getNews, newsIndexHref, archiveActive, NEWS_BASE, type NewsItem, type NewsImage } from '../../lib/news';

export async function getStaticPaths() {
  const news = await getNews();
  return news.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props as { item: NewsItem };
const news = await getNews();
const indexHref = newsIndexHref(news.length);
const others = news.filter((n) => n.slug !== item.slug).slice(0, 3);
const { Content: PlContent } = await item.pl.render();
const EnContent = item.en ? (await item.en.render()).Content : null;

// Zdjęcie główne bez kadrowania: pionowe zdjęcie zwężamy tak, by miało maks. ~720 px wysokości.
const cover = item.cover;
const coverAr = cover && cover.w && cover.h ? cover.w / cover.h : 0;
const coverMax = coverAr ? Math.min(1080, Math.round(720 * coverAr)) : 1080;

// Galeria „wierszami”: zdjęcie szerokie (w/h > 1.3) w osobnym rzędzie, pozostałe parami;
// w rzędzie wspólna wysokość, bez kadrowania (flex-grow = proporcje zdjęcia).
const ar = (g: NewsImage) => (g.w && g.h ? g.w / g.h : 1.5);
const rows: { g: NewsImage; i: number }[][] = [];
item.gallery.forEach((g, i) => {
  const last = rows[rows.length - 1];
  const wide = ar(g) > 1.3;
  if (wide || !last || last.length > 1 || ar(last[0].g) > 1.3) rows.push([{ g, i }]);
  else last.push({ g, i });
});
// Maks. wysokość rzędu ~620 px (pionowe zdjęcia nie zajmują całego ekranu): rząd zwężamy i centrujemy.
const ROW_H = 620, GAP = 14;
const rowMax = (row: { g: NewsImage }[]) => Math.round(row.reduce((s, { g }) => s + ar(g), 0) * ROW_H + GAP * (row.length - 1));
// Lightbox: zdjęcie główne + galeria.
const lbOffset = cover ? 1 : 0;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: item.pl.data.title,
  description: item.pl.data.excerpt,
  datePublished: item.dateIso,
  inLanguage: 'pl',
  ...(cover ? { image: [new URL(cover.src, Astro.site).toString()] } : {}),
  publisher: { '@type': 'Organization', name: 'ICPE Mission Warszawa', url: 'https://icpemission.pl/' },
  mainEntityOfPage: new URL(item.href, Astro.site).toString(),
};
---

<LandingLayout
  title={`${item.pl.data.title} — ICPE Mission Warszawa`}
  description={item.pl.data.excerpt}
  ogImage={cover?.src}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={item.dateIso} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <SiteShell base="/" newsHref={indexHref}>
    <article class="post">
      <header class="post-head">
        <a class="back" href={indexHref}>
          <span aria-hidden="true">←</span>
          {archiveActive(news.length)
            ? (<><span data-pl>Wszystkie nowości</span><span data-en>All news</span></>)
            : (<><span data-pl>Nowości</span><span data-en>News</span></>)}
        </a>
        <NewsMeta item={item} class="post-meta" />
        <h1><Bi pl={item.pl.data.title} en={item.en?.data.title} /></h1>
        <p class="post-lead"><Bi pl={item.pl.data.excerpt} en={item.en?.data.excerpt} /></p>
      </header>

      {cover && (
        <figure class="post-cover" style={`max-width:${coverMax}px;`}>
          <button type="button" class="lb-open" data-lb-index="0" aria-label="Powiększ zdjęcie">
            <img src={cover.src} alt={cover.alt} width={cover.w || undefined} height={cover.h || undefined} loading="eager" decoding="async" data-lb-src={cover.src} data-lb-cap={cover.alt} />
          </button>
        </figure>
      )}

      <div class="post-body">
        {EnContent ? (
          <>
            <div data-pl><PlContent /></div>
            <div data-en><EnContent /></div>
          </>
        ) : (
          <>
            <p class="en-note" data-en>This news item is available in Polish only.</p>
            <PlContent />
          </>
        )}
      </div>

      {rows.length > 0 && (
        <section class="post-gallery" aria-label="Galeria zdjęć">
          {rows.map((row) => (
            <div class="g-row" style={`max-width:${rowMax(row)}px;`}>
              {row.map(({ g, i }) => (
                <figure class="g-item" style={`flex:${ar(g).toFixed(4)} 1 0%;`}>
                  <button type="button" class="lb-open" data-lb-index={i + lbOffset} aria-label="Powiększ zdjęcie">
                    <img src={g.src} alt={g.alt} width={g.w || undefined} height={g.h || undefined} loading="lazy" decoding="async" style={`aspect-ratio:${ar(g).toFixed(4)};`} data-lb-src={g.src} data-lb-cap={g.caption || ''} data-lb-cap-en={g.captionEn || g.caption || ''} />
                  </button>
                  {g.caption && <figcaption><Bi pl={g.caption} en={g.captionEn} /></figcaption>}
                </figure>
              ))}
            </div>
          ))}
        </section>
      )}

      <footer class="post-foot">
        <a class="pill" href={indexHref}>
          <span aria-hidden="true">←</span>
          {archiveActive(news.length)
            ? (<><span data-pl>Wszystkie nowości</span><span data-en>All news</span></>)
            : (<><span data-pl>Wróć do nowości</span><span data-en>Back to news</span></>)}
        </a>
        <button type="button" class="pill share" data-share hidden><span data-pl>Udostępnij</span><span data-en>Share</span></button>
        <button type="button" class="pill share" data-copy><span class="copy-label"><span data-pl>Kopiuj link</span><span data-en>Copy link</span></span><span class="copied" hidden><span data-pl>Skopiowano ✓</span><span data-en>Copied ✓</span></span></button>
      </footer>
    </article>

    {others.length > 0 && (
      <section class="others" aria-labelledby="others-title">
        <div class="others-head">
          <h2 id="others-title" class="kicker"><span data-pl>Więcej nowości</span><span data-en>More news</span></h2>
          {archiveActive(news.length) && <a class="all-link" href={`${NEWS_BASE}/`}><span data-pl>Wszystkie nowości</span><span data-en>All news</span> <span aria-hidden="true">→</span></a>}
        </div>
        <div class="others-grid">
          {others.map((n) => <NewsCard item={n} />)}
        </div>
      </section>
    )}
  </SiteShell>

  <dialog class="lb" data-lb aria-label="Zdjęcie">
    <button type="button" class="lb-close" data-lb-close aria-label="Zamknij">×</button>
    <button type="button" class="lb-nav lb-prev" data-lb-prev aria-label="Poprzednie">‹</button>
    <figure class="lb-fig">
      <img data-lb-img alt="" />
      <figcaption data-lb-caption></figcaption>
    </figure>
    <button type="button" class="lb-nav lb-next" data-lb-next aria-label="Następne">›</button>
    <div class="lb-count" data-lb-count></div>
  </dialog>
</LandingLayout>

<style>
  .post { padding: 56px 72px 72px; }
  .post-head { max-width: 820px; margin: 0 auto; }
  .back { display: inline-flex; gap: 8px; font-size: 14px; font-weight: 600; color: #6B615A; text-decoration: none; margin-bottom: 40px; }
  .back:hover { color: #C0603C; }
  .post-head :global(.post-meta) { font-size: 12.5px; }
  h1 { margin: 18px 0 0; font-size: clamp(36px, 5.2vw, 62px); line-height: 1.02; letter-spacing: -.035em; font-weight: 800; text-wrap: balance; }
  .post-lead { margin: 24px 0 0; font-family: 'Instrument Serif', serif; font-style: italic; font-size: clamp(21px, 2.2vw, 27px); line-height: 1.38; color: #3A3028; max-width: 46ch; }

  .post-cover { margin: 48px auto 0; }
  .post-cover img { width: 100%; height: auto; border-radius: 16px; border: 1px solid #E2D8C8; }

  .lb-open { display: block; width: 100%; padding: 0; margin: 0; border: 0; background: none; cursor: zoom-in; }

  /* treść z Markdown (elementy spoza komponentu → :global) */
  .post-body { max-width: 700px; margin: 56px auto 0; font-size: 18.5px; line-height: 1.72; color: #3A3028; }
  .post-body :global(> div > :first-child), .post-body :global(> :first-child) { margin-top: 0; }
  .post-body :global(p) { margin: 0 0 1.15em; }
  .post-body :global(h2) { margin: 1.9em 0 .6em; font-size: 30px; line-height: 1.12; letter-spacing: -.025em; font-weight: 800; color: #241E1A; }
  .post-body :global(h3) { margin: 1.6em 0 .5em; font-size: 22px; line-height: 1.2; letter-spacing: -.015em; font-weight: 700; color: #241E1A; }
  .post-body :global(a) { color: #C0603C; text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  .post-body :global(a:hover) { color: #8E4229; }
  .post-body :global(strong) { color: #241E1A; font-weight: 700; }
  .post-body :global(ul), .post-body :global(ol) { margin: 0 0 1.2em; padding-left: 1.3em; }
  .post-body :global(li) { margin: .35em 0; }
  .post-body :global(li::marker) { color: #C0603C; }
  .post-body :global(blockquote) { margin: 1.8em 0; padding: 4px 0 4px 30px; border-left: 2px solid #C0603C; font-family: 'Instrument Serif', serif; font-style: italic; font-size: 27px; line-height: 1.36; color: #3A3028; }
  .post-body :global(blockquote p) { margin: 0 0 .5em; }
  .post-body :global(blockquote p:last-child) { margin: 0; }
  .post-body :global(hr) { border: 0; height: 1px; background: #E2D8C8; margin: 2.4em 0; }
  .post-body :global(img) { border-radius: 14px; border: 1px solid #E2D8C8; margin: 1.6em auto; }
  .en-note { font-family: 'Space Mono', monospace; font-size: 12.5px; letter-spacing: .04em; color: #8A7F73; border: 1px dashed #C9BCA9; border-radius: 10px; padding: 10px 14px; margin: 0 0 1.6em !important; }

  /* galeria */
  .post-gallery { max-width: 1080px; margin: 56px auto 0; display: flex; flex-direction: column; gap: 14px; }
  .g-row { display: flex; gap: 14px; align-items: flex-start; width: 100%; margin: 0 auto; }
  .g-item { margin: 0; min-width: 0; }
  .g-item img { width: 100%; height: auto; border-radius: 12px; border: 1px solid #E2D8C8; display: block; transition: opacity .2s; }
  .g-item .lb-open:hover img { opacity: .9; }
  .g-item figcaption { margin-top: 8px; font-size: 13.5px; line-height: 1.45; color: #6B615A; }

  .post-foot { max-width: 700px; margin: 56px auto 0; padding-top: 28px; border-top: 1px solid #E2D8C8; display: flex; flex-wrap: wrap; gap: 12px; }
  .pill { display: inline-flex; align-items: center; gap: 8px; padding: 12px 20px; border-radius: 100px; border: 1px solid #C9BCA9; background: transparent; color: #241E1A; font: 600 14.5px/1 'Bricolage Grotesque', sans-serif; text-decoration: none; cursor: pointer; transition: background .2s, color .2s, border-color .2s; }
  .pill:hover { background: #241E1A; color: #F4EEE3; border-color: #241E1A; }
  .pill[hidden], .copied[hidden], .copy-label[hidden] { display: none; }

  /* więcej nowości */
  .others { margin: 0 24px 24px; padding: 64px 48px 72px; background: #EDE5D7; border-radius: 20px; }
  .others-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; flex-wrap: wrap; margin-bottom: 32px; }
  .kicker { margin: 0; font-family: 'Space Mono', monospace; font-size: 13px; font-weight: 400; letter-spacing: .14em; text-transform: uppercase; color: #A0724F; }
  .all-link { font-size: 15px; font-weight: 600; color: #241E1A; text-decoration: none; }
  .all-link span[aria-hidden] { color: #C0603C; }
  .all-link:hover { text-decoration: underline; text-underline-offset: 4px; }
  .others-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px 32px; }

  /* lightbox */
  .lb { width: 100vw; height: 100vh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgba(20, 15, 11, .97); color: #EDE3D3; }
  .lb[open] { display: grid; grid-template-columns: 64px 1fr 64px; align-items: center; }
  .lb::backdrop { background: rgba(20, 15, 11, .6); }
  .lb-fig { grid-column: 2; margin: 0; display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .lb-fig img { max-width: 100%; max-height: calc(100vh - 120px); width: auto; height: auto; border-radius: 6px; }
  .lb-fig figcaption { font-size: 14px; color: rgba(237, 227, 211, .8); text-align: center; max-width: 70ch; min-height: 1em; }
  .lb-nav, .lb-close { background: none; border: 0; color: #EDE3D3; cursor: pointer; font-size: 44px; line-height: 1; padding: 10px; opacity: .75; }
  .lb-nav:hover, .lb-close:hover { opacity: 1; }
  .lb-prev { grid-column: 1; }
  .lb-next { grid-column: 3; }
  .lb-close { position: absolute; top: 12px; right: 16px; font-size: 40px; }
  .lb-count { position: absolute; top: 24px; left: 24px; font-family: 'Space Mono', monospace; font-size: 12px; letter-spacing: .1em; color: rgba(237, 227, 211, .6); }

  @media (max-width: 900px) {
    .others-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .post { padding: 36px 22px 56px; }
    .back { margin-bottom: 28px; }
    .post-cover { margin-top: 36px; }
    .post-body { margin-top: 40px; font-size: 17.5px; }
    .post-body :global(blockquote) { font-size: 23px; padding-left: 20px; }
    .post-gallery { gap: 8px; }
    .g-row { gap: 8px; }
    .others { margin: 0 12px 12px; padding: 44px 22px 52px; }
    .others-grid { grid-template-columns: 1fr; gap: 40px; }
    .lb[open] { grid-template-columns: 40px 1fr 40px; }
    .lb-nav { font-size: 34px; padding: 4px; }
  }
</style>

<script is:inline>
  (function () {
    // Lightbox (zdjęcie główne + galeria): klik, strzałki, Esc, przesunięcie palcem.
    var dlg = document.querySelector('[data-lb]');
    var imgs = Array.prototype.slice.call(document.querySelectorAll('[data-lb-src]'));
    if (dlg && imgs.length && typeof dlg.showModal === 'function') {
      var im = dlg.querySelector('[data-lb-img]'), cap = dlg.querySelector('[data-lb-caption]'), cnt = dlg.querySelector('[data-lb-count]');
      var cur = 0;
      var many = imgs.length > 1;
      dlg.querySelector('[data-lb-prev]').style.visibility = many ? '' : 'hidden';
      dlg.querySelector('[data-lb-next]').style.visibility = many ? '' : 'hidden';
      var lang = function () { var r = document.getElementById('site-root'); return (r && r.getAttribute('data-lang')) || 'pl'; };
      var show = function (i) {
        cur = (i + imgs.length) % imgs.length;
        var el = imgs[cur];
        im.src = el.getAttribute('data-lb-src');
        im.alt = el.alt || '';
        var c = lang() === 'en' ? (el.getAttribute('data-lb-cap-en') || el.getAttribute('data-lb-cap')) : el.getAttribute('data-lb-cap');
        cap.textContent = c || '';
        cnt.textContent = many ? (cur + 1) + ' / ' + imgs.length : '';
      };
      document.querySelectorAll('[data-lb-index]').forEach(function (b) {
        b.addEventListener('click', function () { show(+b.getAttribute('data-lb-index')); dlg.showModal(); });
      });
      dlg.querySelector('[data-lb-close]').addEventListener('click', function () { dlg.close(); });
      dlg.querySelector('[data-lb-prev]').addEventListener('click', function () { show(cur - 1); });
      dlg.querySelector('[data-lb-next]').addEventListener('click', function () { show(cur + 1); });
      dlg.addEventListener('click', function (e) { if (e.target === dlg) dlg.close(); });
      dlg.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowLeft') show(cur - 1);
        if (e.key === 'ArrowRight') show(cur + 1);
      });
      var x0 = null;
      dlg.addEventListener('touchstart', function (e) { x0 = e.touches[0].clientX; }, { passive: true });
      dlg.addEventListener('touchend', function (e) {
        if (x0 === null) return;
        var dx = e.changedTouches[0].clientX - x0; x0 = null;
        if (Math.abs(dx) > 50) show(cur + (dx < 0 ? 1 : -1));
      });
    }

    // Udostępnij (gdy przeglądarka wspiera) + Kopiuj link.
    var share = document.querySelector('[data-share]');
    if (share && navigator.share) {
      share.hidden = false;
      share.addEventListener('click', function () { navigator.share({ title: document.title, url: location.href }).catch(function () {}); });
    }
    var copy = document.querySelector('[data-copy]');
    if (copy) copy.addEventListener('click', function () {
      var done = function () {
        copy.querySelector('.copy-label').hidden = true; copy.querySelector('.copied').hidden = false;
        setTimeout(function () { copy.querySelector('.copy-label').hidden = false; copy.querySelector('.copied').hidden = true; }, 2200);
      };
      if (navigator.clipboard) navigator.clipboard.writeText(location.href).then(done, function () {});
    });
  })();
</script>

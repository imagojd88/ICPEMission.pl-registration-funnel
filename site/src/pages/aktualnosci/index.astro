---
// Stary adres /aktualnosci (dawna lista artykułów z CMS) → nowa sekcja Nowości.
// Od 2026-10-20 nowości są plikami w src/content/nowosci (patrz lib/news.ts).
import LandingLayout from '../../layouts/LandingLayout.astro';

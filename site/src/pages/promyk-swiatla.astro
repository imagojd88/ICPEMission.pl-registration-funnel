---
// /promyk-swiatla — strona książki „Promyk światła. Historia Misji ICPE" (Anna Cappello Fava).
// Strona statyczna (nie z CMS) — wygrywa z [slug].astro. Wszystkie dane do uzupełnienia
// są w dwóch obiektach poniżej: BOOK i PREMIERE. Puste pole = element się nie pokazuje
// albo pokazuje wersję „wkrótce".
import LandingLayout from '../layouts/LandingLayout.astro';
import PremiereBanner from '../components/PremiereBanner.astro';

const BOOK = {
  title: 'Promyk światła',
  subtitle: 'Historia Misji ICPE',
  author: 'Anna Cappello Fava',
  originalTitle: 'A Cast of Light. The Story of the ICPE Mission',
  /** Zdjęcie okładki PL (np. '/uploads/promyk-okladka.jpg', proporcja ~2:3). Puste → okładka rysowana w CSS. */
  coverImage: '',
  /** Dane wydania — pokazują się tylko wypełnione. */
  publisher: '',
  translator: '',
  pages: '',
  format: '',
  isbn: '',
  /** Link do zakupu / przedsprzedaży polskiego wydania. Puste → komunikat „wkrótce". */
  buyUrl: '',
  englishEditionUrl: 'https://www.amazon.com/Cast-Light-Story-ICPE-Mission/dp/1505135958/',
};

const PREMIERE = {
  date: '2026-10-16', // YYYY-MM-DD, czas polski
  /** Godzina rozpoczęcia 'HH:MM' — puste → „godzinę podamy wkrótce", kalendarz jako wydarzenie całodniowe. */
  time: '',
  durationMin: 120,
  city: 'Kraków',
  /** Miejsce (np. 'Kościół …, ul. …'). Puste → „miejsce podamy wkrótce". */
  venue: '',
  /** Link do wydarzenia w Lumie. Puste → przyciski prowadzą do sekcji premiery. */
  lumaUrl: '',
};

// ── pochodne ────────────────────────────────────────────────────────────
const MONTHS = ['stycznia', 'lutego', 'marca', 'kwietnia', 'maja', 'czerwca', 'lipca', 'sierpnia', 'września', 'października', 'listopada', 'grudnia'];
const DAYS = ['niedziela', 'poniedziałek', 'wtorek', 'środa', 'czwartek', 'piątek', 'sobota'];
const [py, pm, pd] = PREMIERE.date.split('-').map(Number);
const weekday = DAYS[new Date(Date.UTC(py, pm - 1, pd)).getUTCDay()];
const dateLong = `${pd} ${MONTHS[pm - 1]} ${py}`;
const dd = String(pd).padStart(2, '0');
const mm = String(pm).padStart(2, '0');
const signupHref = PREMIERE.lumaUrl || '#premiera';
const signupExt = PREMIERE.lumaUrl ? { target: '_blank', rel: 'noopener' } : {};

const editionRows = [
  ['Tytuł', `${BOOK.title}. ${BOOK.subtitle}`],
  ['Autorka', BOOK.author],
  ['Tytuł oryginału', BOOK.originalTitle],
  ['Wydawca', BOOK.publisher],
  ['Przekład', BOOK.translator],
  ['Liczba stron', BOOK.pages],
  ['Format', BOOK.format],
  ['ISBN', BOOK.isbn],
].filter(([, v]) => v);

// Zdanie-obietnica: słowa „zapalają się" przy przewijaniu.
const PROMISE = 'Zaczną tam, gdzie są — i nie zatrzymają się, dopóki nie obejdą całego świata.';
const promiseWords = PROMISE.split(' ');

const PATH = [
  { year: 'Początek lat 80.', place: 'Malta', text: 'Anna i Mario gromadzą wokół siebie ludzi, którzy chcą żyć jak pierwsi chrześcijanie: we wspólnocie otwartej dla każdego i prowadzonej przez Ducha Świętego.' },
  { year: '1985', place: 'Malta', text: 'Powstaje Instytut Ewangelizacji Świata – ICPE Mission. Wspólnota zaczyna formować świeckich i posyłać ich w świat.' },
  { year: 'Kolejne dekady', place: 'Wszystkie kontynenty', text: 'Misjonarze docierają do miejsc, gdzie światło Chrystusa bywa jedynym promykiem nadziei. Rodzi się też HopeXchange, humanitarne ramię misji.' },
  { year: '2025', place: 'Cały Kościół', text: 'Czterdziesta rocznica założenia ICPE Mission.' },
  { year: '2026', place: 'Kraków', text: 'Historia trafia do polskich czytelników. Premiera polskiej edycji 16 października.' },
];

const QUOTES = [
  {
    text: '„Promyk światła” Anny Cappello to historia owocowania podstawowych cnót misjonarzy: odwagi, cierpliwości, zaufania i… odrobiny improwizacji. Jest to przekonujące świadectwo, jak dzisiaj światłość Chrystusa staje się dla wielu jedynym promykiem nadziei. To także teologicznie głębokie nauczanie o tym, jak być uczniem-misjonarzem, jak formować do ewangelizacji, jak być liderem wspólnoty z misją. Z ujmującym pięknem wznieca iskierkę radości i dodaje siły!',
    name: 'ks. Sławomir Pawłowski SAC',
    role: 'Katolicki Uniwersytet Lubelski Jana Pawła II, sekretarz Rady KEP ds. Ekumenizmu, doradca duchowy wspólnot ICPE Mission w Polsce',
  },
  {
    text: 'Misjonarze ICPE są pionierami! W czasach, gdy niewielu katolików nawet mówiło o ewangelizacji, a tym bardziej ją prowadziło, ICPE Mission zaczęła formować i wysyłać świeckich, aby nieśli światło Chrystusa do niektórych z najciemniejszych miejsc na świecie. Kościół powinien wiele nauczyć się z tej inspirującej historii.',
    name: 'Mary Healy',
    role: 'profesor biblistyki, członkini Dykasterii ds. Popierania Jedności Chrześcijan, Papieskiej Komisji Biblijnej oraz Dykasterii ds. Kultu Bożego i Dyscypliny Sakramentów',
  },
];

const description = '„Promyk światła. Historia Misji ICPE” — książka Anny Cappello Favy, współzałożycielki ICPE Mission. Premiera polskiej edycji: 16 października 2026, Kraków.';
---

<LandingLayout title={`${BOOK.title}. ${BOOK.subtitle} — Anna Cappello Fava`} description={description} ogImage={BOOK.coverImage || undefined}>
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Book',
      name: `${BOOK.title}. ${BOOK.subtitle}`,
      author: { '@type': 'Person', name: BOOK.author },
      inLanguage: 'pl',
      ...(BOOK.isbn ? { isbn: BOOK.isbn } : {}),
      ...(BOOK.publisher ? { publisher: { '@type': 'Organization', name: BOOK.publisher } } : {}),
    })} />
  </Fragment>

  <div class="ps" id="top">
    <PremiereBanner href={PREMIERE.lumaUrl} date={PREMIERE.date} city={PREMIERE.city} />

    <!-- NAV -->
    <header class="nav" data-nav>
      <div class="nav-in">
        <a href="/" class="brand" aria-label="ICPE Mission — strona główna">
          <img src="/assets/icpe-globe-cream.png" alt="" width="34" height="34" class="logo logo-dark" />
          <img src="/assets/icpe-globe.png" alt="" width="34" height="34" class="logo logo-light" />
          <span>ICPE Mission</span>
        </a>
        <nav class="nav-links" aria-label="Sekcje strony">
          <a href="#o-ksiazce">O książce</a>
          <a href="#autorka">Autorka</a>
          <a href="#glosy">Rekomendacje</a>
          <a href="#premiera">Premiera</a>
        </nav>
        <a class="btn btn-beam btn-sm" href={signupHref} {...signupExt}>Zapisz się na premierę</a>
      </div>
    </header>

    <!-- HERO -->
    <section class="hero" data-hero>
      <div class="beam" aria-hidden="true">
        <span class="ray r1"></span><span class="ray r2"></span><span class="ray r3"></span>
      </div>
      <canvas class="motes" data-motes aria-hidden="true"></canvas>

      <div class="hero-in">
        <div class="hero-copy">
          <p class="kicker">Nowa książka współzałożycielki ICPE Mission</p>
          <h1 class="title">
            <span class="t1">Promyk</span>
            <span class="t2">światła</span>
          </h1>
          <p class="subtitle">Historia Misji ICPE</p>
          <p class="byline">{BOOK.author}</p>
          <p class="lede">Opowieść o małej wspólnocie z Malty, która uwierzyła, że Ewangelia może dotrzeć na krańce ziemi, i wyruszyła w drogę.</p>
          <div class="hero-cta">
            <a class="btn btn-beam" href={signupHref} {...signupExt}>Zapisz się na premierę</a>
            <a class="btn btn-ghost" href="#o-ksiazce">Poznaj książkę</a>
          </div>
          <p class="hero-date"><time datetime={PREMIERE.date}>{weekday}, {dateLong}</time>, {PREMIERE.city}</p>
        </div>

        <div class="hero-book" data-tilt>
          <div class="book">
            <div class="book-front">
              {BOOK.coverImage ? (
                <img src={BOOK.coverImage} alt={`Okładka książki ${BOOK.title}`} class="cover-img" />
              ) : (
                <div class="cover" role="img" aria-label={`Okładka: ${BOOK.title}. ${BOOK.subtitle}. ${BOOK.author}`}>
                  <span class="cover-rays"></span>
                  <span class="cover-author">{BOOK.author}</span>
                  <span class="cover-title"><em>Promyk</em><em>światła</em></span>
                  <span class="cover-sub">historia misji icpe</span>
                </div>
              )}
              <span class="book-sheen" aria-hidden="true"></span>
            </div>
            <div class="book-spine" aria-hidden="true"><span>Promyk światła</span></div>
            <div class="book-pages" aria-hidden="true"></div>
          </div>
          <div class="book-shadow" aria-hidden="true"></div>
        </div>
      </div>
    </section>

    <!-- OBIETNICA — słowa zapalają się przy przewijaniu -->
    <section class="promise" data-promise aria-label="Obietnica założycieli">
      <div class="promise-in">
        <p class="promise-lead">Na początku była jedna śmiała obietnica.</p>
        <p class="promise-text" aria-label={PROMISE}>
          {promiseWords.map((w, i) => <span class="w" style={`--i:${i}`} aria-hidden="true">{w} </span>)}
        </p>
      </div>
    </section>

    <div class="dawn" aria-hidden="true"></div>

    <!-- O KSIĄŻCE -->
    <section class="about" id="o-ksiazce">
      <div class="wrap about-grid">
        <h2 class="h2">Z małej wyspy<br />aż po krańce ziemi</h2>
        <div class="about-body">
          <p class="drop">Na początku lat 80. na małej śródziemnomorskiej wyspie katolickie małżeństwo zgromadziło wokół siebie ludzi, którzy chcieli żyć tak jak pierwsi chrześcijanie: we wspólnocie otwartej dla każdego i prowadzonej przez Ducha Świętego. Kiedy ich życie zmieniło się nie do poznania, postanowili podzielić się tym, czego doświadczyli.</p>
          <p>„Promyk światła” to opowieść o tym, jak ta decyzja stała się Misją ICPE, spisana przez kobietę, która jest w niej od pierwszego dnia. To historia ludzi, którzy zostawili to, co znane, żeby nieść Ewangelię tam, gdzie była najbardziej potrzebna.</p>
          <div class="inside">
            <h3 class="h3">Co znajdziesz w książce</h3>
            <ul>
              <li>Jak z modlitwy kilku osób na Malcie wyrosła międzynarodowa wspólnota misyjna.</li>
              <li>Świadectwa z miejsc, w których światło Chrystusa bywa jedynym promykiem nadziei.</li>
              <li>Praktyczną mądrość o tym, jak być uczniem-misjonarzem i jak formować do ewangelizacji.</li>
              <li>Doświadczenie prowadzenia wspólnoty, która żyje misją: odwagę, cierpliwość, zaufanie i odrobinę improwizacji.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- DROGA — oś czasu -->
    <section class="path" id="droga" data-path>
      <div class="wrap">
        <h2 class="h2 path-h">Droga, o której opowiada książka</h2>
        <div class="path-track">
        <span class="path-line" aria-hidden="true"><span class="path-fill" data-path-fill></span></span>
        <ol class="path-list">
          {PATH.map((s) => (
            <li class="step">
              <span class="step-dot" aria-hidden="true"></span>
              <p class="step-year">{s.year}</p>
              <p class="step-place">{s.place}</p>
              <p class="step-text">{s.text}</p>
            </li>
          ))}
        </ol>
        </div>
      </div>
    </section>

    <!-- AUTORKA -->
    <section class="author" id="autorka">
      <div class="wrap author-grid">
        <figure class="author-photo">
          <div class="arch">
            <img src="/uploads/462623044_7856737674427104_2359881754499323139_n.jpg" alt="Anna Cappello Fava i Mario Cappello" width="683" height="683" loading="lazy" />
          </div>
          <figcaption>Anna i Mario Cappello, założyciele ICPE Mission</figcaption>
        </figure>
        <div class="author-body">
          <h2 class="h2">Anna Cappello Fava</h2>
          <p class="author-lead">Współzałożycielka ICPE Mission. Od ponad czterdziestu lat razem z mężem Mario prowadzi rozwój wspólnoty na całym świecie, także jej humanitarnego ramienia HopeXchange.</p>
          <p>Ukończyła teologię w Rzymie (licencjat kanoniczny). Prowadzi rekolekcje, formację i opiekę duszpasterską w ICPE Mission, a z Mario seminaria o małżeństwie, przywództwie i rozeznawaniu.</p>
          <p>Bliska jest jej edukacja i godność kobiet: założyła program edukacyjny dla dzieci w Ghanie oraz Woman-to-Woman, posługę wspierającą kobiety na całym świecie. Gdy nie jest w podróży misyjnej, mieszka z mężem na Malcie.</p>
        </div>
      </div>
    </section>

    <!-- REKOMENDACJE -->
    <section class="voices" id="glosy">
      <div class="wrap">
        <h2 class="h2 voices-h">Rekomendacje</h2>
        <div class="voices-grid">
          {QUOTES.map((q, i) => (
            <figure class={`voice v${i + 1}`}>
              <svg class="voice-mark" viewBox="0 0 40 40" aria-hidden="true"><g stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M20 3v8M20 29v8M3 20h8M29 20h8M8 8l5.5 5.5M26.5 26.5L32 32M32 8l-5.5 5.5M13.5 26.5L8 32"/></g><circle cx="20" cy="20" r="4" fill="currentColor"/></svg>
              <blockquote><p>{q.text}</p></blockquote>
              <figcaption>
                <span class="voice-name">{q.name}</span>
                <span class="voice-role">{q.role}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- PREMIERA -->
    <section class="premiere" id="premiera" data-premiere data-date={PREMIERE.date} data-time={PREMIERE.time} data-duration={PREMIERE.durationMin} data-city={PREMIERE.city} data-venue={PREMIERE.venue} data-url={PREMIERE.lumaUrl}>
      <div class="beam beam-soft" aria-hidden="true"><span class="ray r1"></span><span class="ray r2"></span></div>
      <div class="wrap premiere-grid">
        <div class="premiere-date" aria-hidden="true">
          <span class="pd-day">{dd}</span><span class="pd-sep">.</span><span class="pd-month">{mm}</span>
          <span class="pd-year">{py}</span>
        </div>
        <div class="premiere-body">
          <h2 class="h2">Premiera polskiej edycji</h2>
          <p class="premiere-when"><time datetime={PREMIERE.date}>{weekday}, {dateLong}</time>, {PREMIERE.city}</p>
          <dl class="premiere-facts">
            <div><dt>Miejsce</dt><dd>{PREMIERE.venue || 'podamy wkrótce'}</dd></div>
            <div><dt>Godzina</dt><dd>{PREMIERE.time || 'podamy wkrótce'}</dd></div>
          </dl>
          <p class="premiere-text">Zapraszamy na pierwsze spotkanie z polskim wydaniem „Promyka światła”. Zapisz się, a prześlemy Ci szczegóły i przypomnienie przed wydarzeniem.</p>

          <div class="countdown" data-countdown aria-live="polite">
            <div><span data-cd="d">–</span><small data-cdl="d">dni</small></div>
            <div><span data-cd="h">–</span><small data-cdl="h">godzin</small></div>
            <div><span data-cd="m">–</span><small data-cdl="m">minut</small></div>
          </div>
          <p class="countdown-done" data-countdown-done hidden>Premiera odbyła się {dateLong} w Krakowie. Dziękujemy, że byliście z nami.</p>

          <div class="premiere-cta">
            {PREMIERE.lumaUrl ? (
              <a class="btn btn-beam" href={PREMIERE.lumaUrl} target="_blank" rel="noopener">Zapisz się na premierę</a>
            ) : (
              <span class="btn btn-beam is-soon" aria-disabled="true">Zapisy otworzymy wkrótce</span>
            )}
            <button type="button" class="btn btn-ghost" data-ics>Dodaj do kalendarza</button>
          </div>
        </div>
      </div>
    </section>

    <!-- WYDANIE -->
    <section class="edition" id="wydanie">
      <div class="wrap edition-grid">
        <div>
          <h2 class="h2">Polskie wydanie</h2>
          {BOOK.buyUrl ? (
            <p class="edition-lead">Książka jest już dostępna.</p>
          ) : (
            <p class="edition-lead">Informację o sprzedaży polskiego wydania podamy wkrótce na tej stronie.</p>
          )}
          <div class="edition-cta">
            {BOOK.buyUrl && <a class="btn btn-ink" href={BOOK.buyUrl} target="_blank" rel="noopener">Kup książkę</a>}
            {BOOK.englishEditionUrl && <a class="link" href={BOOK.englishEditionUrl} target="_blank" rel="noopener">Wydanie angielskie „A Cast of Light” na Amazonie</a>}
          </div>
        </div>
        <dl class="edition-list">
          {editionRows.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
        </dl>
      </div>
    </section>

    <!-- STOPKA -->
    <footer class="foot">
      <div class="wrap foot-in">
        <a href="/" class="brand">
          <img src="/assets/icpe-globe-cream.png" alt="" width="30" height="30" />
          <span>ICPE Mission Polska</span>
        </a>
        <p>Instytut Ewangelizacji Świata – ICPE Mission. Międzynarodowa katolicka wspólnota, która formuje uczniów-misjonarzy.</p>
        <nav class="foot-links" aria-label="Linki">
          <a href="/">icpemission.pl</a>
          <a href="https://www.icpe.org" target="_blank" rel="noopener">ICPE International</a>
          <a href="https://www.instagram.com/icpemission360/" target="_blank" rel="noopener">Instagram</a>
        </nav>
      </div>
    </footer>
  </div>
</LandingLayout>

<style>
  /* ── Tokeny: zieleń okładki + światło słońca przez liście ─────────────── */
  .ps {
    --night: #0c1a14;
    --moss: #17301f;
    --fern: #3e6b4a;
    --beam: #f2d48a;
    --beam-hi: #fff3cf;
    --ember: #85601c;
    --day: #f5f1e2;
    --day-2: #ebe5cf;
    --ink: #16241c;
    --ink-soft: #46554b;
    --line: rgba(22, 36, 28, 0.14);
    --serif: 'Cormorant Garamond', 'Times New Roman', serif;
    --sans: 'Bricolage Grotesque', system-ui, sans-serif;
    background: var(--day);
    color: var(--ink);
    font-family: var(--sans);
    overflow-x: clip;
  }
  :where(.ps) :where(h1, h2, h3, p, ul, ol, dl, dd, figure, blockquote) { margin: 0; }
  .wrap { max-width: 1200px; margin: 0 auto; padding: 0 40px; }
  .h2 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(38px, 5vw, 64px);
    line-height: 1.02;
    letter-spacing: -0.01em;
  }
  .h3 { font-family: var(--sans); font-size: 17px; font-weight: 600; letter-spacing: 0; }
  :focus-visible { outline: 2px solid var(--beam); outline-offset: 3px; border-radius: 4px; }

  /* Przyciski */
  .btn {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 50px; padding: 0 26px; border-radius: 100px;
    font: 600 15.5px/1 var(--sans); text-decoration: none; cursor: pointer;
    border: 1px solid transparent; transition: background 0.2s, color 0.2s, border-color 0.2s, box-shadow 0.3s;
  }
  .btn-sm { min-height: 40px; padding: 0 18px; font-size: 14px; }
  .btn-beam { background: var(--beam); color: var(--night); box-shadow: 0 0 0 0 rgba(242, 212, 138, 0); }
  .btn-beam:hover { background: var(--beam-hi); box-shadow: 0 0 36px 2px rgba(242, 212, 138, 0.35); }
  .btn-beam.is-soon { opacity: 0.6; cursor: default; box-shadow: none; }
  .btn-ghost { background: transparent; color: var(--day); border-color: rgba(245, 241, 226, 0.35); }
  .btn-ghost:hover { border-color: var(--beam); color: var(--beam); }
  .btn-ink { background: var(--ink); color: var(--day); }
  .btn-ink:hover { background: var(--moss); }

  /* ── NAV ─────────────────────────────────────────────────────────────── */
  .nav { position: sticky; top: 0; z-index: 50; color: var(--day); transition: background 0.35s, color 0.35s, box-shadow 0.35s; }
  .nav-in { max-width: 1320px; margin: 0 auto; padding: 16px 40px; display: flex; align-items: center; gap: 28px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; color: inherit; text-decoration: none; font-weight: 700; font-size: 16px; letter-spacing: -0.01em; }
  .brand img { width: 34px; height: 34px; }
  .logo-light { display: none; }
  .nav-links { display: flex; gap: 26px; margin-left: auto; font-size: 14.5px; }
  .nav-links a { color: inherit; text-decoration: none; opacity: 0.82; }
  .nav-links a:hover { opacity: 1; text-decoration: underline; text-underline-offset: 5px; }
  .nav.is-solid { background: rgba(12, 26, 20, 0.86); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); box-shadow: 0 1px 0 rgba(242, 212, 138, 0.14); }
  .nav.is-light { background: rgba(245, 241, 226, 0.9); color: var(--ink); box-shadow: 0 1px 0 var(--line); }

          var m = motes[i];
          m.x += m.vx + Math.sin(m.t) * 0.08; m.y += m.vy; m.t += 0.01;
          if (m.y < -10) { m.y = H + 10; m.x = Math.random() * W; }
          if (m.x < -10) m.x = W + 10; if (m.x > W + 10) m.x = -10;
          // jaśniej w okolicy snopa (prawa górna część)
          var inBeam = Math.max(0, 1 - Math.abs(m.x / W - (0.72 - (m.y / H) * 0.35)) * 3.2);
          var a = 0.12 + inBeam * 0.6 + Math.sin(m.t * 3) * 0.06;
          ctx.beginPath(); ctx.arc(m.x, m.y, m.r, 0, 6.283);
          ctx.fillStyle = 'rgba(255,240,196,' + a.toFixed(3) + ')'; ctx.fill();
        }
        requestAnimationFrame(frame);
      }
      size(); frame();
      window.addEventListener('resize', size);
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (es) {
          var vis = es[0].isIntersecting;
          if (vis && !running) { running = true; frame(); } else if (!vis) running = false;
        }).observe(canvas);
      }
    }

    // PREMIERA: odliczanie + plik .ics do kalendarza.
    var sec = document.querySelector('[data-premiere]');
    if (sec) {
      var date = sec.getAttribute('data-date');
      var time = sec.getAttribute('data-time');
      var dur = parseInt(sec.getAttribute('data-duration') || '120', 10);
      // 16.10 w Polsce = czas letni (UTC+2)
      var start = new Date(date + 'T' + (time || '00:00') + ':00+02:00');
      var endOfDay = new Date(date + 'T23:59:59+02:00');
      var cd = sec.querySelector('[data-countdown]');
      var done = sec.querySelector('[data-countdown-done]');
      function plural(n, one, few, many) {
        if (n === 1) return one;
        var d = n % 10, t = n % 100;
        return d >= 2 && d <= 4 && (t < 12 || t > 14) ? few : many;
      }
      function tick() {
        var now = Date.now();
        if (now > endOfDay.getTime()) { cd.hidden = true; done.hidden = false; return; }
        var ms = Math.max(0, start.getTime() - now);
        var d = Math.floor(ms / 864e5), h = Math.floor(ms / 36e5) % 24, m = Math.floor(ms / 6e4) % 60;
        cd.querySelector('[data-cd="d"]').textContent = d;
        cd.querySelector('[data-cd="h"]').textContent = h;
        cd.querySelector('[data-cd="m"]').textContent = m;
        cd.querySelector('[data-cdl="d"]').textContent = d === 1 ? 'dzień' : 'dni';
        cd.querySelector('[data-cdl="h"]').textContent = plural(h, 'godzina', 'godziny', 'godzin');
        cd.querySelector('[data-cdl="m"]').textContent = plural(m, 'minuta', 'minuty', 'minut');
      }
      tick(); setInterval(tick, 30000);

      var icsBtn = sec.querySelector('[data-ics]');
      if (icsBtn) icsBtn.addEventListener('click', function () {
        var ymd = date.replace(/-/g, '');
        var pad = function (n) { return String(n).padStart(2, '0'); };
        var lines = ['BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//ICPE Mission Polska//Promyk swiatla//PL', 'CALSCALE:GREGORIAN', 'BEGIN:VEVENT',
          'UID:premiera-promyk-swiatla-' + ymd + '@icpemission.pl',
          'DTSTAMP:' + new Date().toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '')];
        if (time) {
          var s = new Date(date + 'T' + time + ':00+02:00');
          var e = new Date(s.getTime() + dur * 6e4);
          var z = function (x) { return x.getUTCFullYear() + pad(x.getUTCMonth() + 1) + pad(x.getUTCDate()) + 'T' + pad(x.getUTCHours()) + pad(x.getUTCMinutes()) + '00Z'; };
          lines.push('DTSTART:' + z(s), 'DTEND:' + z(e));
        } else {
          var n = new Date(date + 'T12:00:00Z'); n.setUTCDate(n.getUTCDate() + 1);
          lines.push('DTSTART;VALUE=DATE:' + ymd, 'DTEND;VALUE=DATE:' + n.getUTCFullYear() + pad(n.getUTCMonth() + 1) + pad(n.getUTCDate()));
        }
        var venue = sec.getAttribute('data-venue');
        var city = sec.getAttribute('data-city');
        var url = sec.getAttribute('data-url') || (location.origin + location.pathname);
        lines.push('SUMMARY:Premiera książki „Promyk światła”', 'LOCATION:' + (venue ? venue + '\\, ' : '') + city,
          'DESCRIPTION:Premiera polskiej edycji książki Anny Cappello Favy „Promyk światła. Historia Misji ICPE”. ' + url,
          'URL:' + url, 'END:VEVENT', 'END:VCALENDAR');
        var blob = new Blob([lines.join('\r\n')], { type: 'text/calendar;charset=utf-8' });
        var a = document.createElement('a');
        a.href = URL.createObjectURL(blob); a.download = 'premiera-promyk-swiatla.ics';
        document.body.appendChild(a); a.click(); a.remove();
        setTimeout(function () { URL.revokeObjectURL(a.href); }, 1000);
      });
    }
  })();
</script>

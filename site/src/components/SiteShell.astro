---
// Wspólna „rama” strony icpemission.pl: kontener języka (PL/EN), nawigacja, stopka,
// antyspamowe linki e-mail i przełącznik języka. Używana przez stronę główną i podstrony Nowości.
// Wydzielone 1:1 z pages/index.astro (2026-10-20) — zmiany nawigacji/stopki rób TUTAJ.
interface Props {
  /** Prefiks kotwic sekcji strony głównej: "" na stronie głównej, "/" na podstronach. */
  base?: string;
  /** Link „Nowości” w nawigacji i stopce (null = ukryty, gdy nie ma żadnego wpisu). */
  newsHref?: string | null;
}
const { base = '', newsHref = null } = Astro.props;
---

<div data-lang="pl" id="site-root" style="background:#F4EEE3; color:#241E1A; min-height:100vh; font-family:'Bricolage Grotesque',sans-serif;">
  <script is:inline>
    // Język startowy — zanim wyrenderuje się treść (bez mignięcia PL). Reguła jak w
    // src/scripts/lang-pref.ts: ?lang= → zapamiętany wybór (cookie icpe_lang, wspólne z rejestracją)
    // → języki przeglądarki (pierwszy obsługiwany) → w każdym innym wypadku EN. Strona ma PL i EN.
    (function () {
      var av = ['pl', 'en'], r = document.getElementById('site-root');
      var n = function (v) { var c = String(v || '').toLowerCase().slice(0, 2); return av.indexOf(c) > -1 ? c : null; };
      var l = null;
      try { l = n(new URLSearchParams(location.search).get('lang')); } catch (e) {}
      // Zapis wyboru gościa: cookie na całą icpemission.pl (wspólne z rejestracja.icpemission.pl) + localStorage.
      window.__icpeSaveLang = function (v) {
        var d = /(^|\.)icpemission\.pl$/.test(location.hostname) ? '; domain=.icpemission.pl' : '';
        try { document.cookie = 'icpe_lang=' + v + '; path=/; max-age=31536000; SameSite=Lax' + d; } catch (e) {}
        try { localStorage.setItem('icpe_lang', v); } catch (e) {}
      };
      if (l) window.__icpeSaveLang(l);
      if (!l) { try { var m = document.cookie.match(/(?:^|;\s*)icpe_lang=([a-z]{2})/); l = n(m && m[1]); } catch (e) {} }
      if (!l) { try { l = n(localStorage.getItem('icpe_lang')); } catch (e) {} }
      if (!l) {
        var list = (navigator.languages && navigator.languages.length) ? navigator.languages : [navigator.language];
        for (var i = 0; i < list.length && !l; i++) l = n(list[i]);
      }
      l = l || 'en';
      r.setAttribute('data-lang', l);
      document.documentElement.setAttribute('lang', l);
    })();
  </script>
  <div style="max-width:1320px; margin:0 auto; background:#F4EEE3; overflow:hidden;">
    <!-- NAV -->
    <nav style="display:flex; align-items:center; justify-content:space-between; padding:26px 72px; border-bottom:1px solid #E2D8C8; position:sticky; top:0; z-index:50; background:rgba(244,238,227,.9); backdrop-filter:blur(10px);">
      <a href="/" aria-label="ICPE Mission Warszawa — strona główna" style="display:flex; align-items:center; gap:11px; color:inherit; text-decoration:none;">
        <img src="/assets/icpe-globe.png" alt="ICPE" style="height:40px; width:auto; display:block;" />
        <div style="font-size:19px; font-weight:800; letter-spacing:-.02em;">ICPE Mission <span style="font-weight:400; color:#6B615A;">Warszawa</span></div>
      </a>
      <div class="nav-links" style="display:flex; align-items:center; gap:30px; font-size:15px; font-weight:500;">
        {newsHref && <a href={newsHref} style="color:inherit; text-decoration:none;"><span data-pl>Nowości</span><span data-en>News</span></a>}
        <a href={`${base}#wspolnota`} style="color:inherit; text-decoration:none;"><span data-pl>Wspólnota</span><span data-en>Community</span></a>
        <a href={`${base}#mapa`} style="color:inherit; text-decoration:none;"><span data-pl>Świat</span><span data-en>World</span></a>
        <a href={`${base}#polska`} style="color:inherit; text-decoration:none;"><span data-pl>Polska</span><span data-en>Poland</span></a>
        <a href={`${base}#events`} style="color:inherit; text-decoration:none;"><span data-pl>Wydarzenia</span><span data-en>Events</span></a>
      </div>
      <div style="display:flex; align-items:center; gap:18px; margin-left:32px;">
        <div style="display:flex; align-items:center; gap:8px; font-family:'Space Mono',monospace; font-size:13px;">
          <button data-langbtn="pl" style="background:none; border:none; font:inherit; color:inherit; padding:0;">PL</button>
          <span style="color:#C4B8A6;">/</span>
          <button data-langbtn="en" style="background:none; border:none; font:inherit; color:inherit; padding:0;">EN</button>
        </div>
        <a href="#kontakt" class="js-mail" data-mail="d2Fyc3phd2FAaWNwZW1pc3Npb24ucGw=" data-subject="Kontakt — ICPE Mission Warszawa" style="display:inline-flex; padding:11px 20px; border-radius:100px; background:#241E1A; color:#F4EEE3; font-size:14px; font-weight:600; text-decoration:none;"><span data-pl>Napisz do nas</span><span data-en>Get in touch</span></a>
      </div>
    </nav>

    <slot />

    <!-- FOOTER -->
    <footer id="kontakt" style="background:#241E1A; color:#EDE3D3; padding:64px 72px 40px;">
      <div class="footer-grid" style="display:grid; grid-template-columns:1.5fr 1fr 1.1fr 1.3fr; gap:40px;">
        <div>
          <div style="display:flex; align-items:center; gap:11px; margin-bottom:18px;"><img src="/assets/icpe-globe-cream.png" alt="ICPE" style="height:34px; width:auto; display:block;" /><div style="font-size:18px; font-weight:800;">ICPE Mission Warszawa</div></div>
          <p style="margin:0 0 18px; font-size:14px; line-height:1.6; color:rgba(237,227,211,.65); max-width:34ch;"><span data-pl>Instytut Ewangelizacji Świata – ICPE Mission.</span><span data-en>Institute for World Evangelisation – ICPE Mission.</span></p>
          <a href="#kontakt" class="js-mail" data-mail="d2Fyc3phd2FAaWNwZW1pc3Npb24ucGw=" data-subject="Kontakt — ICPE Mission Warszawa" data-showtext="1" style="color:rgba(237,227,211,.85); text-decoration:none; font-size:15px;"></a>
        </div>
        <div><div style="font-family:'Space Mono',monospace; font-size:12px; letter-spacing:.1em; text-transform:uppercase; color:rgba(237,227,211,.5); margin-bottom:14px;"><span data-pl>Nawigacja</span><span data-en>Navigate</span></div><div style="display:flex; flex-direction:column; gap:10px; font-size:15px;">{newsHref && <a href={newsHref} style="color:inherit; text-decoration:none;"><span data-pl>Nowości</span><span data-en>News</span></a>}<a href={`${base}#wspolnota`} style="color:inherit; text-decoration:none;"><span data-pl>Wspólnota</span><span data-en>Community</span></a><a href={`${base}#mapa`} style="color:inherit; text-decoration:none;"><span data-pl>Mapa świata</span><span data-en>World map</span></a><a href={`${base}#events`} style="color:inherit; text-decoration:none;"><span data-pl>Wydarzenia</span><span data-en>Events</span></a></div></div>
        <div><div style="font-family:'Space Mono',monospace; font-size:12px; letter-spacing:.1em; text-transform:uppercase; color:rgba(237,227,211,.5); margin-bottom:14px;"><span data-pl>ICPE w sieci</span><span data-en>ICPE online</span></div><div style="display:flex; flex-direction:column; gap:10px; font-size:15px;"><a href="https://www.icpe.org" target="_blank" rel="noopener noreferrer" style="color:inherit; text-decoration:none;">ICPE International</a><a href="https://www.icpebook.org/" target="_blank" rel="noopener noreferrer" style="color:inherit; text-decoration:none;">ICPE Book</a><a href="https://hopexchangemedicalcenter.org/" target="_blank" rel="noopener noreferrer" style="color:inherit; text-decoration:none;">HopeXchange</a></div></div>
        <div><div style="font-family:'Space Mono',monospace; font-size:12px; letter-spacing:.1em; text-transform:uppercase; color:rgba(237,227,211,.5); margin-bottom:14px;">Social</div><div style="display:flex; flex-direction:column; gap:10px; font-size:15px;"><a href="https://www.instagram.com/icpemission360/" target="_blank" rel="noopener noreferrer" style="color:inherit; text-decoration:none;">Instagram · icpemission360</a><a href="https://www.facebook.com/profile.php?id=61583565058942" target="_blank" rel="noopener noreferrer" style="color:inherit; text-decoration:none;">Facebook · ICPE Warszawa</a><a href="https://www.facebook.com/ICPEMissionSeminary" target="_blank" rel="noopener noreferrer" style="color:inherit; text-decoration:none;">Facebook · Seminary</a><a href="https://www.facebook.com/profile.php?id=100068380218392" target="_blank" rel="noopener noreferrer" style="color:inherit; text-decoration:none;">Facebook · ICPE 360</a></div></div>
      </div>
      <div style="margin-top:48px; padding-top:22px; border-top:1px solid #43372C; display:flex; justify-content:space-between; font-family:'Space Mono',monospace; font-size:12px; color:rgba(237,227,211,.45);"><span>© 2026 ICPE Polska</span><span>Warszawa · PL</span></div>
    </footer>
  </div>
</div>

<style>
  /* Responsywność nawigacji i stopki (przeniesione z pages/index.astro). */
  @media (max-width: 900px) {
    .footer-grid { grid-template-columns: 1fr !important; }
    .nav-links { display: none !important; }
  }
  @media (max-width: 560px) {
    #site-root nav { padding: 20px 22px !important; }
  }
</style>

<script is:inline>
  // E-mail antyspam: adres trzymany jako base64 w data-mail, mailto składany dopiero w JS,
  // więc w źródle HTML nie ma czytelnego wzorca „x@y" do zebrania przez boty.
  document.querySelectorAll('.js-mail').forEach((el) => {
    try {
      const email = atob(el.getAttribute('data-mail') || '');
      if (!email) return;
      const subj = el.getAttribute('data-subject');
      el.setAttribute('href', 'mailto:' + email + (subj ? '?subject=' + encodeURIComponent(subj) : ''));
      if (el.hasAttribute('data-showtext') && !el.textContent.trim()) el.textContent = email;
    } catch (e) { /* ignore */ }
  });

  // Przełącznik języka PL/EN — ustawia data-lang na kontenerze (CSS steruje widocznością).
  const root = document.getElementById('site-root');
  document.querySelectorAll('[data-langbtn]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const lng = btn.getAttribute('data-langbtn');
      if (root && lng) {
        root.setAttribute('data-lang', lng);
        document.documentElement.setAttribute('lang', lng);
        // Ręczny wybór zapamiętany (także dla rejestracji i formacji).
        if (window.__icpeSaveLang) window.__icpeSaveLang(lng);
      }
    });
  });
</script>

---
// Baner „Premiera polskiej edycji" — samodzielny (własne style), do użycia na
// /promyk-swiatla i opcjonalnie na stronie głównej:
//   <PremiereBanner href="https://lu.ma/..." />
// Po dniu premiery chowa się sam (skrypt sprawdza datę w przeglądarce),
// więc nie trzeba przebudowywać strony, żeby go zdjąć.
interface Props {
  /** Link do wydarzenia (Luma). Pusty → kotwica do sekcji premiery na stronie książki. */
  href?: string;
  /** Dzień premiery, YYYY-MM-DD (czas polski). */
  date?: string;
  city?: string;
}
const { href = '', date = '2026-10-16', city = 'Kraków' } = Astro.props;

const MONTHS = ['stycznia', 'lutego', 'marca', 'kwietnia', 'maja', 'czerwca', 'lipca', 'sierpnia', 'września', 'października', 'listopada', 'grudnia'];
const [y, m, d] = date.split('-').map(Number);
const dateLabel = `${d} ${MONTHS[m - 1]} ${y}`;
const link = href || '/promyk-swiatla#premiera';
const external = /^https?:\/\//.test(link);
---

<aside class="pb" data-premiere-banner data-until={date} aria-label="Premiera polskiej edycji książki Promyk Światła">
  <a class="pb-in" href={link} {...(external ? { target: '_blank', rel: 'noopener' } : {})}>
    <span class="pb-spark" aria-hidden="true"></span>
    <span class="pb-text">
      <strong>Premiera polskiej edycji „Promyka Światła”</strong>
      <span class="pb-when"><time datetime={date}>{dateLabel}</time>, {city}</span>
    </span>
    <span class="pb-cta">{href ? 'Zapisz się' : 'Szczegóły'}</span>
  </a>
</aside>

<style>
  .pb {
    position: relative;
    z-index: 60;
    background: #10231a;
    color: #f5f1e2;
    border-bottom: 1px solid rgba(242, 212, 138, 0.22);
    font-family: 'Bricolage Grotesque', system-ui, sans-serif;
  }
  .pb-in {
    max-width: 1320px;
    margin: 0 auto;
    padding: 11px 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    color: inherit;
    text-decoration: none;
    font-size: 14.5px;
    line-height: 1.35;
  }
  .pb-text { display: flex; flex-wrap: wrap; column-gap: 10px; row-gap: 2px; align-items: baseline; }
  .pb-text strong { font-weight: 600; }
  .pb-when { color: #f2d48a; }
  .pb-cta {
    flex: 0 0 auto;
    padding: 6px 14px;
    border-radius: 100px;
    border: 1px solid rgba(242, 212, 138, 0.55);
    color: #f2d48a;
    font-weight: 600;
    font-size: 13.5px;
    transition: background 0.2s, color 0.2s;
  }
  .pb-in:hover .pb-cta,
  .pb-in:focus-visible .pb-cta { background: #f2d48a; color: #10231a; }
  .pb-in:focus-visible { outline: 2px solid #f2d48a; outline-offset: -4px; }
  .pb-spark {
    flex: 0 0 auto;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #f2d48a;
    box-shadow: 0 0 0 0 rgba(242, 212, 138, 0.6);
    animation: pb-glow 2.8s ease-out infinite;
  }
  @keyframes pb-glow {
    0% { box-shadow: 0 0 0 0 rgba(242, 212, 138, 0.55); }
    70% { box-shadow: 0 0 0 10px rgba(242, 212, 138, 0); }
    100% { box-shadow: 0 0 0 0 rgba(242, 212, 138, 0); }
  }
  @media (max-width: 560px) {
    .pb-in { justify-content: space-between; padding: 10px 16px; font-size: 13.5px; }
    .pb-spark { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pb-spark { animation: none; }
  }
</style>

<script is:inline>
  // Po dniu premiery (od północy 17.10 czasu PL) baner znika bez przebudowy strony.
  document.querySelectorAll('[data-premiere-banner]').forEach(function (el) {
    var d = el.getAttribute('data-until');
    if (!d) return;
    var end = new Date(d + 'T23:59:59+02:00');
    if (Date.now() > end.getTime()) el.remove();
  });
</script>

// ICPE Registration — Prisma Schema
// Provider: postgresql
// Pricing config stored as JSON (PricingConfig from @icpe/shared)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  COORDINATOR
  // Pomocnik eventu: wyłącznie Recepcja (/desk/*) i tylko eventy z EventStaffGrant.
  // NIE ma wstępu na /admin/* (JwtAuthGuard wpuszcza tylko trzy role powyżej).
  EVENT_STAFF
}

enum EventType {
  ONE_TIME
  EVERGREEN
  STANDALONE
  INVITE
}

enum RsvpResponse {
  YES
  NO
}

enum InstanceStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum PaymentMethod {
  ONLINE
  BANK_TRANSFER
  CASH
  LEADER_DEPOSIT // zaliczka u lidera wspólnoty ICPE + reszta gotówką na miejscu
}

enum PaymentStatus {
  PENDING
  PAID
  AWAITING_TRANSFER
  FAILED
  REFUNDED
}

enum RegistrationStatus {
  DRAFT
  PENDING_PAYMENT
  AWAITING_TRANSFER
  CONFIRMED
  WAITLIST
  CANCELLED
}

enum PricingModel {
  PER_PERSON
  PER_ROOM
  PER_PERSON_PER_NIGHT
  SINGLE_SUPPLEMENT
}

enum GenderPolicy {
  ANY
  MALE
  FEMALE
  FAMILY
}

enum ParticipantType {
  ADULT
  CHILD
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

// ─── Models ───────────────────────────────────────────────────────────────────

// Przesłane obrazki (np. tło hero eventu) — trzymane w bazie, bo dysk Rendera jest ulotny.
model Upload {
  id        String   @id @default(cuid())
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
}

model Organization {
  id          String  @id @default(cuid())
  name        String
  currency    String  @default("PLN")
  bankDetails Json?
  branding    Json?
  settings    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         AdminRole
  locale       String    @default("pl")
  staffGrants  EventStaffGrant[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Dostęp pomocnika (AdminUser z rolą EVENT_STAFF) do JEDNEGO eventu w wybranych zakresach.
// Zakresy: stałe DESK_SCOPES w shared/src/desk.ts.
model EventStaffGrant {
  id          String        @id @default(cuid())
  adminUserId String
  adminUser   AdminUser     @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  instanceId  String
  instance    EventInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  scopes      String[]
  createdBy   String
  createdAt   DateTime      @default(now())
  expiresAt   DateTime?

  @@unique([adminUserId, instanceId])
  @@index([instanceId])
}

model ServiceToken {
  id         String   @id @default(cuid())
  name       String
  tokenHash  String   @unique
  scopes     String[]
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())
}

model GuestAccount {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String?
  firstName    String
  lastName     String
  phone        String?
  address      Json?
  locale       String         @default("pl")
  profile      Json?
  registrations Registration[]
  enrollments   CourseEnrollment[]
  passwordSetAt DateTime?        // panel kursanta: kiedy ustawiono hasło
  lastLoginAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model EventSeries {
  id                          String          @id @default(cuid())
  type                        EventType
  recurrence                  String?
  registrationOpenOffsetDays  Int?
  registrationCloseOffsetDays Int?
  defaultSettings             Json?
  page                        RegistrationPage?
  instances                   EventInstance[]
  translations                Translation[]
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt
}

model EventInstance {
  id                   String          @id @default(cuid())
  seriesId             String
  series               EventSeries     @relation(fields: [seriesId], references: [id])
  title                Json
  description          Json?
  startsAt             DateTime
  endsAt               DateTime
  location             String?
  // Kraj eventu: kod ISO 3166-1 alpha-2 („PL”, „IT”, „MT”); null = nie ustawiono. API ICPE Go → countryCode.
  countryCode          String?
  nights               Int             @default(0)
  capacity             Int?
  status               InstanceStatus  @default(DRAFT)
  // Kiedy admin ręcznie otworzył ponownie zamknięty event — automat (EventsService.closeExpired)
  // nie zamyka wtedy eventu drugi raz, nawet jeśli minęło 7 dni od końca.
  reopenedAt           DateTime?
  // Udostępnianie danych aplikacji ICPE Go (GET /icpe-go/events) — włącza admin w edycji eventu.
  // Domyślnie wyłączone: event nie istnieje dla ICPE Go, dopóki ktoś go świadomie nie udostępni.
  shareWithIcpeGo      Boolean         @default(false)
  // Ukryty event: działa normalnie pod bezpośrednim linkiem /r/<slug> (zapis, płatności, maile,
  // strona zgłoszenia, recepcja), ale nie trafia na żadną publiczną listę (strona główna,
  // icpemission.pl, lista ICPE Go). Panel i Personal OS widzą go ze znacznikiem.
  unlisted             Boolean         @default(false)
  registrationOpensAt  DateTime
  registrationClosesAt DateTime
  paymentMethods       PaymentMethod[]
  // PricingConfig JSON from @icpe/shared — canonical pricing engine config
  pricingConfig        Json
  options              Json?
  roomTypes            RoomType[]
  rooms                Room[]
  registrations        Registration[]
  leads                RegistrationLead[]
  waitlist             WaitlistEntry[]
  staffGrants          EventStaffGrant[]
  rsvps                EventRsvp[]
  invitations          Invitation[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
}

// Lekkie potwierdzenie obecności dla eventów typu STANDALONE (bez noclegu, bezpłatne).
model EventRsvp {
  id         String        @id @default(cuid())
  instanceId String
  instance   EventInstance @relation(fields: [instanceId], references: [id])
  name       String
  email      String?
  response   RsvpResponse
  guestId    String?
  locale     String        @default("pl")
  editToken  String        @unique @default(cuid())
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([instanceId])
}

model RegistrationPage {
  id            String      @id @default(cuid())
  seriesId      String      @unique
  series        EventSeries @relation(fields: [seriesId], references: [id])
  slug          String      @unique
  isEvergreen   Boolean
  theme         Json?
  enabledFields Json
  customFields  Json?
  paymentInfo   Json?       // dane przelewu: { recipient, account } (edytowalne per event)
  locales       String[]
  published     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model RoomType {
  id           String       @id @default(cuid())
  instanceId   String
  instance     EventInstance @relation(fields: [instanceId], references: [id])
  name         Json
  capacity     Int
  pricingModel PricingModel
  price        Decimal      @db.Decimal(10, 2)
  genderPolicy GenderPolicy @default(ANY)
  quantity     Int
  rooms        Room[]
  createdAt    DateTime     @default(now())
}

model Room {
  id          String        @id @default(cuid())
  instanceId  String
  instance    EventInstance @relation(fields: [instanceId], references: [id])
  roomTypeId  String
  roomType    RoomType      @relation(fields: [roomTypeId], references: [id])
  label       String
  capacity    Int
  assignments RoomAssignment[]
  createdAt   DateTime      @default(now())
}

model Registration {
  id                  String             @id @default(cuid())
  instanceId          String
  instance            EventInstance      @relation(fields: [instanceId], references: [id])
  guestId             String?
  guest               GuestAccount?      @relation(fields: [guestId], references: [id])
  status              RegistrationStatus @default(DRAFT)
  locale              String
  contact             Json
  preferredRoomTypeId String?
  roomsJson           Json?
  optionsJson         Json?      // opcje wyceny: { transport, bedding } — do edycji/przeliczenia
  discountCode        String?
  dietaryNotes        String?
  totalPrice          Decimal            @db.Decimal(10, 2)
  currency            String             @default("PLN")
  paymentMethod       PaymentMethod?
  checkedInAt         DateTime?          // obecność: znacznik check-in na miejscu (null = nieobecny)
  roomLabel           String?            // zakwaterowanie: numer/nazwa przydzielonego pokoju
  roomNote            String?            // zakwaterowanie: opcjonalny komentarz
  roomsReserved       Boolean            @default(false) // pokoje z puli zarezerwowanej dla gości specjalnych (ustawia admin)
  // Recepcja: kto oznaczył przyjazd oraz wydanie / zwrot klucza (e-mail z tokenu).
  checkedInBy         String?
  keyIssuedAt         DateTime?
  keyIssuedBy         String?
  keyReturnedAt       DateTime?
  keyReturnedBy       String?
  requests            RegistrationRequest[]
  editToken           String             @unique @default(cuid())
  participants        Participant[]
  payments            Payment[]
  assignments         RoomAssignment[]
  notifications       Notification[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model Participant {
  id             String          @id @default(cuid())
  registrationId String
  registration   Registration    @relation(fields: [registrationId], references: [id])
  type           ParticipantType
  firstName      String
  lastName       String
  birthDate      DateTime?
  age            Int?
  gender         Gender
  dietary        String?
  assignment     RoomAssignment?
  createdAt      DateTime        @default(now())
}

model RoomAssignment {
  id             String       @id @default(cuid())
  roomId         String
  room           Room         @relation(fields: [roomId], references: [id])
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id])
  participantId  String?      @unique
  participant    Participant? @relation(fields: [participantId], references: [id])
  assignedBy     String
  assignedAt     DateTime     @default(now())
}

model Payment {
  id             String        @id @default(cuid())
  registrationId String
  registration   Registration  @relation(fields: [registrationId], references: [id])
  provider       String
  method         PaymentMethod
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("PLN")
  status         PaymentStatus @default(PENDING)
  externalId     String?
  raw            Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

/// Próba płatności online (Tpay; później Stripe). Osobna tabela, bo wiersze PENDING w `Payment`
/// są nadpisywane przy edycji zgłoszenia. Po opłaceniu powstaje zwykły wiersz `Payment`
/// (provider 'tpay') i jego id trafia do `paymentId`. Bez relacji — tabela w pełni addytywna.
model OnlinePayment {
  id             String    @id @default(cuid())
  registrationId String
  /// 'tpay' (później 'stripe')
  provider       String    @default("tpay")
  /// nasz identyfikator próby — wysyłany do Tpay jako hiddenDescription, wraca jako tr_crc
  crc            String    @unique
  /// identyfikator transakcji u dostawcy (Tpay: transactionId)
  externalId     String?   @unique
  /// tytuł transakcji u dostawcy (Tpay: TR-…, w powiadomieniu tr_id)
  title          String?
  /// kwota, na którą utworzono płatność
  amount         Decimal   @db.Decimal(10, 2)
  currency       String    @default("PLN")
  /// 'due' | 'remaining' | 'custom'
  purpose        String?
  /// CREATED | PENDING | PAID | REFUNDED | FAILED | EXPIRED
  status         String    @default("CREATED")
  /// kwota faktycznie zapłacona (tr_paid)
  paidAmount     Decimal?  @db.Decimal(10, 2)
  paymentUrl     String?
  /// id zaksięgowanej wpłaty (Payment.id)
  paymentId      String?   @unique
  testMode       Boolean   @default(false)
  /// pola powiadomienia bez e-maila płatnika i bez md5sum
  raw            Json?
  paidAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([registrationId, createdAt])
  @@index([status, createdAt])
}

model MeetingSeries {
  id          String              @id @default(cuid())
  title       Json
  recurrence  String
  occurrences MeetingOccurrence[]
  createdAt   DateTime            @default(now())
}

model MeetingOccurrence {
  id         String            @id @default(cuid())
  seriesId   String
  series     MeetingSeries     @relation(fields: [seriesId], references: [id])
  date       DateTime
  attendance AttendanceRecord[]
  createdAt  DateTime          @default(now())
}

model AttendanceRecord {
  id              String           @id @default(cuid())
  occurrenceId    String
  occurrence      MeetingOccurrence @relation(fields: [occurrenceId], references: [id])
  guestId         String?
  participantName String?
  status          AttendanceStatus
  channel         String
  createdAt       DateTime         @default(now())
}

model Translation {
  id       String @id @default(cuid())
  entity   String
  entityId String
  locale   String
  value    String

  series EventSeries? @relation(fields: [entityId], references: [id])

  @@unique([entity, entityId, locale])
}

model Notification {
  id             String        @id @default(cuid())
  type           String
  channel        String
  to             String
  locale         String
  status         String        @default("QUEUED")
  payload        Json
  // Dostawca, przez który poszedł mail ('resend' | 'smtp' | 'log'), jego id wiadomości
  // i treść błędu — do dziennika wysyłek w Ustawieniach panelu.
  provider       String?
  providerId     String?
  error          String?
  registrationId String?
  registration   Registration? @relation(fields: [registrationId], references: [id])
  createdAt      DateTime      @default(now())
}

// Zapisane miejsca/lokalizacje — wybierane w kreatorze/edycji eventu.
model Place {
  id        String   @id @default(cuid())
  label     String
  createdAt DateTime @default(now())
}

// Biblioteka gości specjalnych — zapisani raz, wybierani przy kolejnych eventach.
// name/bio = mapy językowe {pl, en, it}; photoUrl = wgrany portret.
model SavedGuest {
  id        String   @id @default(cuid())
  name      Json
  bio       Json?
  photoUrl  String?
  plural    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Zaproszenia dla eventów typu INVITE (na zaproszenie).
model Invitation {
  id          String    @id @default(cuid())
  instanceId  String
  instance    EventInstance @relation(fields: [instanceId], references: [id])
  firstName   String
  lastName    String
  email       String
  // Telefon (opcjonalny) — używany do przycisku „Wyślij przez WhatsApp" w panelu.
  phone       String?
  token       String    @unique @default(cuid())
  confirmedAt DateTime?
  // Kiedy ostatnio poszedł mail z zaproszeniem (null = jeszcze nie wysłano).
  sentAt      DateTime?
  dietaryNotes String?
  createdAt   DateTime  @default(now())
  // Deklaracja przy potwierdzeniu: null = jeszcze nie odpowiedział.
  spouseAttending    Boolean?
  spouseFirstName    String?
  spouseLastName     String?
  spouseDietaryNotes String?
  // Lista dzieci: [{ firstName?: string, age: number }]
  childrenJson       Json?
  // Zgłoszenie utworzone przy potwierdzeniu udziału (spina zaproszenie z modułami panelu).
  registrationId String?
  // Ścieżka „uczestnik zaprasza gościa": kto dodał tę osobę. Oba id null = dodana przez admina.
  // invitedByInvitationId — zapraszający to potwierdzony gość eventu INVITE,
  // invitedByRegistrationId — zapraszający to uczestnik zwykłego eventu (zgłoszenie z lejka).
  invitedByInvitationId   String?
  invitedByRegistrationId String?
  // Migawka „Imię Nazwisko" zapraszającego — do etykiety w panelu bez dodatkowych zapytań.
  invitedByName           String?
  // Personalizacja maila z zaproszeniem (panel): własny zwrot, dodatkowa treść, temat,
  // forma grzecznościowa. Puste = standardowy szablon.
  mailSalutation String?
  mailNote       String?  @db.Text
  mailSubject    String?
  mailFormal     Boolean  @default(false)
  // Kto potwierdził udział: 'GUEST' (link / dopasowanie) | 'ADMIN' (panel — „Dodaj jako potwierdzonego"
  // albo „Potwierdź ręcznie"). null = niepotwierdzone albo potwierdzone przed wprowadzeniem pola (= GUEST).
  confirmedBy      String?
  // Ostatni zapis odpowiedzi przez samego gościa (link /i/:token, dopasowanie, odmowa).
  // Przy confirmedBy=ADMIN: null = gość jeszcze nie odpowiedział → dieta nieznana.
  guestRespondedAt DateTime?
  // Odmowa udziału („Nie damy rady przyjść") — przez gościa albo oznaczona przez admina.
  // Wyklucza z potwierdzonych (confirmedAt = null); ponowne potwierdzenie ją czyści.
  declinedAt       DateTime?
  // Notatka wewnętrzna organizatora (np. „potwierdził telefonicznie 3.10") — nie trafia do gościa.
  adminNote        String?

  @@index([instanceId])
}

// ─────────────────────────────────────────────────────────────
// CMS strony ICPE Mission PL (Faza 1) — treść zarządzana z Personal OS,
// konsumowana przez statyczną stronę Astro (endpointy /site/*).
// ─────────────────────────────────────────────────────────────

enum ContentStatus {
  DRAFT
  PUBLISHED
}

// Strona statyczna (o-nas, kontakt, "/" dla home). Treść jako bloki (JSON).
model Page {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  locale      String        @default("pl")
  blocks      Json          @default("[]")
  seoTitle    String?
  seoDesc     String?
  ogImageUrl  String?
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  navOrder    Int?
  showInNav   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// Aktualność / wpis (news, świadectwa). Treść jako bloki (JSON).
model Article {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  locale      String        @default("pl")
  excerpt     String?
  coverUrl    String?
  blocks      Json          @default("[]")
  category    String?
  author      String?
  seoTitle    String?
  seoDesc     String?
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, publishedAt])
}

// Element nawigacji (header/footer) — edytowalne z Personal OS.
model MenuItem {
  id        String   @id @default(cuid())
  label     String
  href      String
  location  String   @default("header") // header | footer
  order     Int      @default(0)
  parentId  String?
  createdAt DateTime @default(now())

  @@index([location, order])
}

// Wspólnota na mapie świata (edytowalne opisy PL/EN dla landingu).
// Struktura (współrzędne, grupa) jest bazowa w kodzie strony; tu edytujemy teksty.
model Community {
  id        String   @id @default(cuid())
  key       String   @unique   // stabilny klucz łączący z pinem na mapie (np. "warszawa")
  name      String
  ccPl      String?
  ccEn      String?
  tagPl     String?
  tagEn     String?
  notePl    String?  @db.Text
  noteEn    String?  @db.Text
  lat       Float
  lng       Float
  grp       String   @default("world") // hub | pl | hq | world
  order     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Ustawienia globalne strony (jeden rekord, id="singleton").
model SiteSettings {
  id                String   @id @default("singleton")
  siteName          String   @default("ICPE Mission Polska")
  logoUrl           String?
  contactEmail      String?
  contactPhone      String?
  socials           Json?    // { facebook, instagram, youtube, ... }
  footerText        String?
  defaultOgImageUrl String?
  hero              Json?    // { rotate: bool, defaultUrl: string|null, images: [{url, position?, alt?}] }
  updatedAt         DateTime @updatedAt
}


// ─── Formacja online (panel kursanta) — docs/13-handoff-formacja-online.md ───

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseItemKind {
  VIDEO
  PDF
}

enum MemberTokenPurpose {
  SET_PASSWORD
  RESET_PASSWORD
}

model Course {
  id                String             @id @default(cuid())
  slug              String             @unique // adres: icpemission.pl/formacja/<slug>
  slugHistory       String[]           @default([]) // stare slugi → przekierowanie
  title             Json // { pl, en? }
  description       Json?
  status            CourseStatus       @default(DRAFT)
  sourceInstanceIds String[]           @default([]) // eventy, których zgłoszenia dają dostęp
  grantOn           String             @default("CONFIRMED") // 'CONFIRMED' | 'ANY_ACTIVE'
  accessUntil       DateTime?
  sequential        Boolean            @default(false) // tryb sekwencyjny: kolejny moduł widoczny po ukończeniu poprzedniego
  items             CourseItem[]
  modules           CourseModule[]
  enrollments       CourseEnrollment[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model CourseItem {
  id           String         @id @default(cuid())
  courseId     String
  course       Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  kind         CourseItemKind
  title        Json
  description  Json?
  order        Int            @default(0)
  moduleId     String? // → CourseModule (null = materiał bez modułu, zawsze dostępny)
  module       CourseModule?  @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  published    Boolean        @default(true)
  publishAt         DateTime? // publikacja zaplanowana: materiał widoczny dla kursantów od tej chwili
  releaseNotifiedAt DateTime? // kiedy wysłano maile „nowe materiały" (null + publishAt w przyszłości = czeka)
  releaseMails      Int? // ilu kursantom wysłano mail przy publikacji (null = bez maila)
  videoId      String? // GUID w Bunny Stream (stary hosting, do 2026-11 — nieużywany)
  videoKey     String? // klucz obiektu w Cloudflare R2 (plik MP4)
  videoSizeMb  Int?
  uploadId     String? // trwający upload wieloczęściowy do R2 (null = zakończony)
  uploadKey    String? // klucz obiektu trwającego uploadu (przy podmianie pliku stary videoKey działa do końca wysyłki)
  thumbKey     String? // miniatura w R2 (JPEG z klatki filmu, robiona w przeglądarce admina)
  videoState   String? // UPLOADING | PROCESSING | READY | FAILED
  durationSec  Int?
  thumbnailUrl String?
  fileId       String? // → PrivateFile (PDF, wersja PL)
  fileIdEn     String? // → PrivateFile (PDF, wersja EN — opcjonalna)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model PrivateFile {
  id           String   @id @default(cuid())
  mimeType     String
  size         Int
  originalName String?
  data         Bytes
  createdAt    DateTime @default(now())
}

/// Moduł kursu = grupa materiałów (np. „Konferencja 1" = film + PDF). Kolejność modułów = `order`.
model CourseModule {
  id          String       @id @default(cuid())
  courseId    String
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       Json // { pl, en? }
  description Json?
  order       Int          @default(0)
  items       CourseItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([courseId])
}

/// Ukończenie materiału przez kursanta: MANUAL (przycisk „Oznaczam jako ukończone"), VIDEO (≥90% obejrzane), PDF (otwarty/pobrany).
model CourseItemCompletion {
  id        String   @id @default(cuid())
  courseId  String
  itemId    String
  guestId   String
  source    String // MANUAL | VIDEO | PDF
  createdAt DateTime @default(now())

  @@unique([itemId, guestId])
  @@index([courseId, guestId])
}

model CourseEnrollment {
  id             String       @id @default(cuid())
  courseId       String
  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  guestId        String
  guest          GuestAccount @relation(fields: [guestId], references: [id])
  source         String // 'AUTO' | 'MANUAL'
  registrationId String?
  revokedAt      DateTime?
  revokedReason  String? // 'ADMIN' (ręcznie — auto-sync nie przywraca) | 'AUTO' (anulowane zgłoszenie)
  welcomeSentAt  DateTime?
  lastSeenAt     DateTime?
  graduatedAt    DateTime? // absolwent: przeniesiony z „bieżących” po ukończeniu kursu (dostęp zostaje)
  createdAt      DateTime     @default(now())

  @@unique([courseId, guestId])
  @@index([registrationId])
}

model MemberToken {
  id        String             @id @default(cuid())
  guestId   String
  purpose   MemberTokenPurpose
  tokenHash String             @unique
  courseId  String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime           @default(now())

  @@index([guestId])
}

// ─── Formacja online — aktywność kursantów (raport w panelu ▸ Aktywność) ───

model CourseEvent {
  id        String   @id @default(cuid())
  courseId  String
  guestId   String
  itemId    String?
  type      String // LOGIN | COURSE_VIEW | VIDEO_PLAY | PDF_OPEN | PDF_DOWNLOAD | EMAIL_LINK | PASSWORD_SET | RESET_REQUEST
  meta      Json?
  createdAt DateTime @default(now())

  @@index([courseId, guestId, createdAt])
}

model VideoProgress {
  id          String    @id @default(cuid())
  courseId    String
  itemId      String
  guestId     String
  buckets     String    @default("") // '1' = obejrzany 10-sekundowy odcinek filmu
  durationSec Int?
  positionSec Int       @default(0) // gdzie ostatnio skończył
  percent     Int       @default(0) // % unikalnie obejrzanych odcinków
  completedAt DateTime? // pierwsze przekroczenie 90%
  firstAt     DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([itemId, guestId])
  @@index([courseId])
}

/// Rozpoczęte, niedokończone zgłoszenie (gość przeszedł krok „Dane”, ale nie wysłał formularza).
/// Tylko dane potrzebne do JEDNEGO przypomnienia po 3 h — bez uczestników, diet i wieku.
/// Usuwane dzień po zakończeniu eventu.
// Lista oczekujących na otwarcie zapisów (strona eventu z licznikiem): jeden mail w chwili startu rejestracji.
model WaitlistEntry {
  id           String        @id @default(cuid())
  instanceId   String
  instance     EventInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  email        String        // małe litery
  locale       String        @default("pl")
  notifiedAt   DateTime?
  /// SENT | FAILED | LOGGED
  notifyStatus String?
  createdAt    DateTime      @default(now())

  @@unique([instanceId, email])
  @@index([instanceId, notifiedAt])
}

model RegistrationLead {
  id             String        @id @default(cuid())
  instanceId     String
  instance       EventInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  email          String        // małe litery
  firstName      String
  lastName       String?
  locale         String        @default("pl")
  /// najdalszy osiągnięty krok formularza (1 = po „Dane”, …)
  step           Int           @default(1)
  /// token do linku „Dokończ zgłoszenie” (wypełnia imię i e-mail)
  token          String        @unique @default(cuid())
  lastActivityAt DateTime      @default(now())
  reminderSentAt DateTime?
  /// SENT | SKIPPED_CLOSED | SKIPPED_FULL | FAILED
  reminderStatus String?
  convertedAt    DateTime?
  registrationId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([instanceId, email])
  @@index([reminderSentAt, convertedAt, lastActivityAt])
}

// ─── Recepcja (stanowisko przyjęć) ────────────────────────────────────────────

// Prośba dodatkowa zgłoszona na recepcji (dieta, dostawka, inne).
model RegistrationRequest {
  id             String       @id @default(cuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  participantId  String?
  kind           String       // DIET | EXTRA_BED | OTHER
  note           String       @default("")
  status         String       @default("OPEN") // OPEN | DONE
  createdBy      String
  createdAt      DateTime     @default(now())
  resolvedBy     String?
  resolvedAt     DateTime?

  @@index([registrationId])
  @@index([status])
}

// Dziennik akcji recepcji: kto, co i kiedy (także cofnięcia, których nie widać w polach zgłoszenia).
model DeskActionLog {
  id             String   @id @default(cuid())
  instanceId     String
  registrationId String?
  action         String
  actor          String
  detail         Json?
  createdAt      DateTime @default(now())

  @@index([instanceId, createdAt])
  @@index([registrationId])
}
